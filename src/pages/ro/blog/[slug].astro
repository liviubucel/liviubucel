---
import type { Language } from '../../../lib/i18n';
import { getPost } from '../../../lib/sanity-queries';
import LayoutBlogPost from '../../../layouts/LayoutBlogPost.astro';
import { PortableText } from 'astro-portabletext';
import { SITE } from '../../../site-config';

const { slug } = Astro.params;
const lang: Language = 'ro';

if (!slug) {
  return Astro.redirect('/ro/blog');
}

// Romanian routes must render an actual Romanian document. Do not silently
// serve the English sibling under a Romanian URL, because that hides broken
// translation/backfill jobs and produces misleading language metadata.
const post = await getPost(slug, lang).catch(() => null);

if (!post) {
  return new Response(null, { status: 404, statusText: 'Traducerea în limba română nu este disponibilă' });
}

const pubDate = post.pubDate ? new Date(post.pubDate) : new Date();

function estimateReadingTime(body: any[]): string {
  if (!body || body.length === 0) return '1 min citire';
  const text = body
    .filter((b) => b._type === 'block')
    .map((b) => b.children?.map((c: any) => c.text).join('') ?? '')
    .join(' ');
  const words = text.trim().split(/\s+/).length;
  const mins = Math.max(1, Math.ceil(words / 200));
  return `${mins} min citire`;
}

const minutesRead = estimateReadingTime(post.body ?? []);
const canonical = `${SITE.site.url}ro/blog/${slug}`;
---

<LayoutBlogPost
  title={post.title}
  description={post.metaDescription ?? post.description ?? post.title}
  pubDate={pubDate}
  minutesRead={minutesRead}
  url={canonical}
  lang={lang}
  keywords={post.keywords}
  ogImage={post.featuredImage?.asset?.url}
>
  {post.body && post.body.length > 0 ? (
    <PortableText value={post.body} />
  ) : (
    <p class="text-neutral-400">Conținut indisponibil.</p>
  )}
</LayoutBlogPost>
