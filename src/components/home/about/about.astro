---
import { Card, CardContent } from '@/components/ui/card'
import Eyebrow from '@/components/shared/eyebrow/eyebrow.astro'
---

<section id='about' class='border-b py-10 sm:py-16 lg:py-24'>
  <div class='mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:space-y-12 lg:px-10.5'>
    <div class='max-w-2xl space-y-3'>
      <Eyebrow text='About me' />
      <h2 class='text-2xl font-semibold tracking-tight md:text-3xl lg:text-4xl'>Security first. Practical by default.</h2>
      <p class='text-muted-foreground text-base leading-relaxed sm:text-lg'>
        I like security work that ends with something concrete: a finding reproduced, an incident understood, a system hardened or a tool that makes the next investigation faster.
      </p>
    </div>

    <div class='grid auto-rows-[minmax(220px,auto)] gap-4 lg:grid-cols-12'>
      <Card className='ring-border overflow-hidden rounded-[26px] p-0 shadow-none lg:col-span-5 lg:row-span-2'>
        <CardContent className='relative flex h-full min-h-[460px] flex-col justify-between p-6 sm:p-8'>
          <div class='absolute right-[-70px] top-[-70px] size-56 rounded-full bg-orange-500/10 blur-3xl'></div>
          <div class='relative z-10 flex items-start justify-between gap-4'>
            <div>
              <p class='text-muted-foreground text-xs font-semibold uppercase tracking-[0.16em]'>Profile</p>
              <h3 class='mt-2 text-2xl font-semibold'>Liviu Bucel</h3>
              <p class='text-muted-foreground mt-1'>Cybersecurity · DFIR · Ethical Hacking</p>
            </div>
            <div class='bg-background ring-border flex size-16 shrink-0 items-center justify-center overflow-hidden rounded-2xl ring-1'>
              <img src='/images/liviu-memoji.webp' alt='Liviu Bucel avatar' class='h-full w-full object-cover' loading='lazy' />
            </div>
          </div>

          <div class='relative z-10 space-y-5'>
            <div class='bg-background/60 ring-border rounded-2xl p-4 ring-1 backdrop-blur'>
              <p class='text-muted-foreground text-xs font-semibold uppercase tracking-[0.15em]'>What I care about</p>
              <p class='mt-2 text-base leading-relaxed'>Understanding how attacks happen, preserving useful evidence, reducing attack surface and making technical findings reproducible.</p>
            </div>
            <div class='flex flex-wrap gap-2'>
              {['Investigation', 'Offensive security', 'Hardening', 'Automation'].map(item => (
                <span class='bg-muted rounded-full px-3 py-1.5 text-xs font-medium'>{item}</span>
              ))}
            </div>
          </div>
        </CardContent>
      </Card>

      <Card className='ring-border overflow-hidden rounded-[26px] p-0 shadow-none lg:col-span-7'>
        <CardContent className='grid h-full gap-6 p-6 sm:p-8 md:grid-cols-[1fr_.9fr] md:items-center'>
          <div>
            <p class='text-muted-foreground text-xs font-semibold uppercase tracking-[0.16em]'>Current focus</p>
            <h3 class='mt-2 text-2xl font-semibold'>DFIR + practical security testing</h3>
            <p class='text-muted-foreground mt-3 leading-relaxed'>I keep pushing deeper into incident response, network analysis, web testing, attack-path discovery and the tooling around them.</p>
          </div>
          <div class='bg-[#0d1117] ring-white/10 rounded-2xl p-4 font-mono text-xs text-slate-300 shadow-2xl ring-1'>
            <div class='mb-4 flex items-center gap-1.5'><span class='size-2 rounded-full bg-red-400'></span><span class='size-2 rounded-full bg-amber-300'></span><span class='size-2 rounded-full bg-emerald-400'></span><span class='ml-2 text-slate-500'>investigation.log</span></div>
            <p><span class='text-emerald-400'>[+]</span> capture network evidence</p>
            <p class='mt-2'><span class='text-sky-400'>[*]</span> reproduce attack path</p>
            <p class='mt-2'><span class='text-amber-300'>[!]</span> isolate root cause</p>
            <p class='mt-2'><span class='text-violet-300'>[#]</span> document remediation</p>
          </div>
        </CardContent>
      </Card>

      <a href='/romania-cyber-monitor' class='group block no-underline lg:col-span-4'>
        <Card className='ring-border h-full overflow-hidden rounded-[26px] p-0 shadow-none transition-transform duration-300 group-hover:-translate-y-1'>
          <CardContent className='flex h-full flex-col p-0'>
            <div class='relative min-h-36 flex-1 overflow-hidden bg-[#0b1220]'>
              <img src='/globe_preview.png' alt='Romania Cyber Monitor preview' class='absolute inset-0 h-full w-full object-cover opacity-80 transition-transform duration-500 group-hover:scale-[1.03]' loading='lazy' />
              <div class='absolute inset-0 bg-gradient-to-t from-black/65 via-transparent to-transparent'></div>
              <span class='absolute left-4 top-4 rounded-full bg-emerald-400/15 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.12em] text-emerald-300 ring-1 ring-emerald-300/20'>Live project</span>
            </div>
            <div class='p-5'>
              <p class='text-muted-foreground text-xs font-semibold uppercase tracking-[0.15em]'>Threat intelligence</p>
              <h3 class='mt-1 text-xl font-semibold'>Romania Cyber Monitor</h3>
            </div>
          </CardContent>
        </Card>
      </a>

      <Card className='ring-border overflow-hidden rounded-[26px] p-0 shadow-none lg:col-span-3'>
        <CardContent className='flex h-full flex-col justify-between p-6'>
          <div>
            <p class='text-muted-foreground text-xs font-semibold uppercase tracking-[0.16em]'>Toolbox</p>
            <h3 class='mt-2 text-xl font-semibold'>Tools I actually use</h3>
          </div>
          <div class='mt-6 flex flex-wrap gap-2'>
            {['Kali Linux', 'Burp Suite', 'Wireshark', 'Nmap', 'Python', 'PowerShell', 'Cloudflare'].map(tool => (
              <span class='bg-background ring-border rounded-lg px-2.5 py-2 text-xs font-medium ring-1'>{tool}</span>
            ))}
          </div>
        </CardContent>
      </Card>
    </div>
  </div>
</section>
