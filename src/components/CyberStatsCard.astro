---
import Card from "./Card/index.astro";
import { Icon } from "astro-icon/components";
import { getCertifications } from "../lib/sanity-queries";

const STATUS_LABEL: Record<string, string> = {
  'earned': 'Earned',
  'in-progress': 'In Progress',
  'planned': 'Planned',
};

const STATUS_COLOR: Record<string, string> = {
  'earned': 'text-green-400',
  'in-progress': 'text-yellow-400',
  'planned': 'text-darkslate-400',
};

let certs = await getCertifications();

if (!certs.length) {
  certs = [
    { _id: '1', name: 'CompTIA Security+', issuer: 'CompTIA', status: 'in-progress', iconType: 'shield' },
    { _id: '2', name: 'CompTIA Network+', issuer: 'CompTIA', status: 'planned', iconType: 'network' },
    { _id: '3', name: 'CCNA', issuer: 'Cisco', status: 'planned', iconType: 'network' },
  ] as any;
}

const displayCerts = certs.slice(0, 3);
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-1" title="Certifications" padding="p-4">
  <div class="flex flex-col gap-1.5 mt-2">
    {displayCerts.map((cert) => {
      const Tag = cert.credentialUrl ? 'a' : 'div';
      return (
        <Tag
          class="flex items-center gap-1.5 min-w-0 group/cert"
          {...(cert.credentialUrl ? { href: cert.credentialUrl, target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {cert.iconType === 'shield' && <Icon name="ri:shield-check-line" class="h-3.5 w-3.5 text-primary-400 shrink-0 group-hover/cert:text-primary-300" />}
          {cert.iconType === 'network' && <Icon name="ri:router-line" class="h-3.5 w-3.5 text-primary-400 shrink-0 group-hover/cert:text-primary-300" />}
          {cert.iconType === 'bug' && <Icon name="ri:bug-line" class="h-3.5 w-3.5 text-primary-400 shrink-0 group-hover/cert:text-primary-300" />}
          {cert.iconType === 'terminal' && <Icon name="ri:terminal-box-line" class="h-3.5 w-3.5 text-primary-400 shrink-0 group-hover/cert:text-primary-300" />}
          {cert.iconType === 'lock' && <Icon name="ri:lock-2-line" class="h-3.5 w-3.5 text-primary-400 shrink-0 group-hover/cert:text-primary-300" />}
          {cert.iconType === 'award' && <Icon name="ri:award-line" class="h-3.5 w-3.5 text-primary-400 shrink-0 group-hover/cert:text-primary-300" />}
          {!['shield','network','bug','terminal','lock','award'].includes(cert.iconType) && <Icon name="ri:award-line" class="h-3.5 w-3.5 text-primary-400 shrink-0 group-hover/cert:text-primary-300" />}
          <span class="font-medium text-xs text-neutral-100 truncate group-hover/cert:text-primary-300">{cert.name}</span>
          <span class={`text-[10px] shrink-0 ml-auto ${STATUS_COLOR[cert.status] ?? 'text-darkslate-300'}`}>
            {cert.status === 'earned' ? '✓' : STATUS_LABEL[cert.status] ?? cert.status}
          </span>
        </Tag>
      );
    })}
  </div>
</Card>
