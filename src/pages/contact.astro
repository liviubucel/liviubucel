---
import type { Language } from '../lib/i18n';
import Layout from '../layouts/Layout.astro';
import Seo from '../components/Seo.astro';
import { SITE } from '../site-config';
import { getPageSeo } from '../lib/sanity-queries';

export const prerender = false;

const lang: Language = 'en';

const topics = [
  'Security Research',
  'Collaboration',
  'Career Opportunity',
  'CTF / Challenge',
  'General Question',
];

const seo = await getPageSeo("contact");
const seoTitle = seo?.title || `Contact — ${SITE.author.fullName}`;
const seoDescription = seo?.description || "Get in touch with Liviu Bucel about cybersecurity, security research, and relevant technical collaboration.";
---

<Layout
  description={seoDescription}
  title={seoTitle}
  lang={lang}
>
  <Seo
    title={seoTitle}
    description={seoDescription}
    lang={lang}
    keywords={seo?.keywords}
    ogImage={seo?.ogImage}
    canonical={`${SITE.site.url}contact`}
  />

  <main class="min-h-screen text-white px-4 py-16 md:py-24 max-w-5xl mx-auto">
    <a
      class="absolute top-4 left-4 md:top-8 md:left-8 text-white bg-neutral-900 hover:bg-neutral-800 px-3 py-1 md:px-4 md:py-2 text-sm border border-neutral-600 rounded-lg transition-colors duration-150"
      href="/"
    >
      ← Back
    </a>

    <div class="mt-12 md:mt-0 grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">

      <!-- Left column: info -->
      <div>
        <p class="text-xs font-medium text-neutral-500 uppercase tracking-widest mb-3">Get in touch</p>
        <h1 class="text-3xl md:text-4xl font-bold leading-tight tracking-tight text-neutral-100 mb-4">
          Let's talk
        </h1>
        <p class="text-neutral-400 text-base leading-relaxed mb-8">
          Whether you have a security question, want to collaborate on a project, or just want to connect — I'm happy to hear from you.
        </p>

        <ul class="space-y-4 mb-8" aria-label="Contact details">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-neutral-700 bg-neutral-800 text-primary-400" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </span>
            <div>
              <p class="text-xs font-medium text-neutral-500 uppercase tracking-wide mb-0.5">Email</p>
              <a href={`mailto:${SITE.links.email}`} class="text-sm text-neutral-200 hover:text-primary-400 transition-colors duration-150">
                {SITE.links.email}
              </a>
            </div>
          </li>

          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-neutral-700 bg-neutral-800 text-primary-400" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057.1 18.08.114 18.1.134 18.114a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
              </svg>
            </span>
            <div>
              <p class="text-xs font-medium text-neutral-500 uppercase tracking-wide mb-0.5">Discord</p>
              <span class="text-sm text-neutral-400">liviubucel</span>
            </div>
          </li>

          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-neutral-700 bg-neutral-800 text-primary-400" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
            </span>
            <div>
              <p class="text-xs font-medium text-neutral-500 uppercase tracking-wide mb-0.5">Response time</p>
              <p class="text-sm text-neutral-300">Usually within 24 hours</p>
            </div>
          </li>
        </ul>

        <div class="rounded-xl border border-neutral-700 bg-neutral-800/50 p-5">
          <p class="text-sm font-semibold text-neutral-100 mb-1">Cybersecurity specific?</p>
          <p class="text-sm text-neutral-400 leading-relaxed">
            For security research, vulnerability disclosure, or incident response questions — I'm happy to discuss responsibly.
          </p>
        </div>
      </div>

      <!-- Right column: form -->
      <div class="rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-8">
        <form id="contact-form" novalidate>
          <div class="space-y-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="space-y-1.5">
                <label for="contact-name" class="text-sm font-medium text-neutral-200">
                  Name <span class="text-red-400" aria-hidden="true">*</span>
                </label>
                <input
                  id="contact-name"
                  type="text"
                  name="name"
                  required
                  autocomplete="name"
                  maxlength="100"
                  placeholder="Your name"
                  class="flex h-10 w-full rounded-xl border border-neutral-600 bg-neutral-900 px-3 py-2 text-sm text-neutral-100 placeholder:text-neutral-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900 transition-colors duration-150"
                />
              </div>

              <div class="space-y-1.5">
                <label for="contact-email" class="text-sm font-medium text-neutral-200">
                  Email <span class="text-red-400" aria-hidden="true">*</span>
                </label>
                <input
                  id="contact-email"
                  type="email"
                  name="email"
                  required
                  autocomplete="email"
                  maxlength="254"
                  placeholder="you@example.com"
                  class="flex h-10 w-full rounded-xl border border-neutral-600 bg-neutral-900 px-3 py-2 text-sm text-neutral-100 placeholder:text-neutral-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900 transition-colors duration-150"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="contact-topic" class="text-sm font-medium text-neutral-200">
                Topic
              </label>
              <select
                id="contact-topic"
                name="topic"
                class="flex h-10 w-full rounded-xl border border-neutral-600 bg-neutral-900 px-3 py-2 text-sm text-neutral-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900 transition-colors duration-150"
              >
                <option value="">Select (optional)</option>
                {topics.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>

            <div class="space-y-1.5">
              <label for="contact-message" class="text-sm font-medium text-neutral-200">
                Message <span class="text-red-400" aria-hidden="true">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                required
                rows="5"
                maxlength="5000"
                placeholder="What's on your mind?"
                class="flex w-full rounded-xl border border-neutral-600 bg-neutral-900 px-3 py-2 text-sm text-neutral-100 placeholder:text-neutral-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900 resize-y min-h-[120px] transition-colors duration-150"
              ></textarea>
            </div>

            <div class="flex items-start gap-2">
              <input
                id="contact-consent"
                type="checkbox"
                name="consent"
                required
                class="mt-0.5 h-4 w-4 shrink-0 rounded border-neutral-600 bg-neutral-900 text-primary-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 cursor-pointer"
              />
              <label for="contact-consent" class="text-xs text-neutral-400 leading-snug">
                I agree to the <a href="/privacy" class="text-primary-400 hover:underline">Privacy Policy</a> and to this message being processed to respond to me.
              </label>
            </div>

            <p class="text-xs text-neutral-500">
              <span class="text-red-400" aria-hidden="true">*</span> Required fields
            </p>

            <button
              type="submit"
              class="inline-flex h-10 w-full items-center justify-center gap-1.5 whitespace-nowrap rounded-xl bg-primary-600 px-5 text-sm font-semibold text-darkslate-900 shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:bg-primary-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900 disabled:pointer-events-none disabled:opacity-60 cursor-pointer"
            >
              <span data-submit-label>Send message</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="m9 6 6 6-6 6" /></svg>
            </button>

            <p
              id="contact-form-status"
              role="status"
              aria-live="polite"
              class="hidden rounded-xl border px-4 py-3 text-sm"
            ></p>
          </div>
        </form>
      </div>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const submitLabel = submitButton?.querySelector('[data-submit-label]') as HTMLElement | null;
    const originalLabel = submitLabel?.textContent ?? 'Send message';
    const consentInput = form.querySelector('#contact-consent') as HTMLInputElement | null;

    status.classList.remove(
      'border-red-500/30', 'bg-red-500/10', 'text-red-400',
      'border-neutral-700', 'bg-neutral-800', 'text-neutral-200',
    );

    if (consentInput && !consentInput.checked) {
      status.textContent = 'Please agree to the privacy policy to send your message.';
      status.classList.remove('hidden');
      status.classList.add('border-red-500/30', 'bg-red-500/10', 'text-red-400');
      return;
    }

    status.classList.add('hidden');

    if (submitButton && submitLabel) {
      submitButton.disabled = true;
      submitLabel.textContent = 'Sending…';
    }

    try {
      const response = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });

      let data: { success: boolean; error?: string };
      try {
        data = await response.json();
      } catch {
        throw new Error('Something went wrong. Please try again or email directly.');
      }

      if (!data.success) throw new Error(data.error || 'Something went wrong. Please try again.');

      form.reset();
      status.textContent = "Thanks! Your message has been sent — I'll get back to you soon.";
      status.classList.add('border-neutral-700', 'bg-neutral-800', 'text-neutral-200');
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.';
      status.classList.add('border-red-500/30', 'bg-red-500/10', 'text-red-400');
    } finally {
      status.classList.remove('hidden');
      if (submitButton && submitLabel) {
        submitButton.disabled = false;
        submitLabel.textContent = originalLabel;
      }
    }
  });
</script>
