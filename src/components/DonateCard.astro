---
import Card from "./Card/index.astro";
import { Icon } from "astro-icon/components";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  title="Support my work"
  href="https://buymeacoffee.com/liviubucel"
>
  <div class="flex flex-col gap-2 mt-4 h-full">
    <p class="text-sm text-darkslate-300 m-0">If you appreciate my content or projects, you can support me here.</p>
    <div class="flex items-center gap-2 text-darkslate-100 mt-auto font-bold hover:text-white transition-colors duration-100 ease-in-out">
      <Icon name="ri:cup-line" class="h-5 w-5" />
      Buy me a coffee
    </div>
  </div>
</Card>
