---
import Card from "./Card/index.astro";
import Pulse from "./Pulse.astro";

interface Props {
  lang?: "en" | "ro";
}

const { lang = "en" } = Astro.props;
const isRO = lang === "ro";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-1" padding="p-4">
  <div class="flex justify-between w-full items-start mb-1">
    <h2 class="text-white text-xl font-bold">{isRO ? "Acum" : "Now"}</h2>
    <Pulse isEmployed={false} />
  </div>
  <a
    href={isRO ? "/ro/contact" : "/contact"}
    class="text-xs leading-4 text-darkslate-300 hover:text-primary-400 transition-colors duration-150"
  >
    {isRO ? "CV disponibil la cerere." : "CV available on request."}
  </a>
</Card>
