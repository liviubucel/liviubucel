---
import Card from "./Card/index.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../site-config";

interface Props {
  lang?: "en" | "ro";
}

const { lang = "en" } = Astro.props;
const isRO = lang === "ro";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  title={isRO ? "Proiecte pe GitHub" : "GitHub projects"}
  href={SITE.links.github}
>
  <div class="flex flex-col gap-2 mt-4 h-full">
    <p class="text-sm text-darkslate-300 m-0">
      {isRO
        ? "Cod, instrumente și proiecte tehnice."
        : "Code, tooling, and technical projects."}
    </p>
    <div class="flex items-center gap-2 text-primary-500 mt-auto font-bold">
      <Icon name="ri:github-fill" class="h-5 w-5" />
      {isRO ? "Vezi GitHub" : "View GitHub"}
    </div>
  </div>
</Card>
