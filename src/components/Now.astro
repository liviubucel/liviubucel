---
import Card from "./Card/index.astro";
import Pulse from "./Pulse.astro";
import { Icon } from "astro-icon/components";

interface Props {
  lang?: "en" | "ro";
}

const { lang = "en" } = Astro.props;
const isRO = lang === "ro";

---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-1" padding="p-4">
  <div class="flex justify-between w-full items-start mb-2">
    <h2 class="text-white text-xl font-bold">{isRO ? "Acum" : "Now"}</h2>
    <Pulse isEmployed={false} />
  </div>
  <p class="text-xs text-darkslate-300 mb-2">
    {isRO
      ? "Acces verificat la CV pentru recrutori și parteneri tehnici."
      : "Verified CV access for recruiters and technical partners."}
  </p>
  <a
    href={isRO ? "/ro/cv" : "/cv"}
    class="text-xs flex items-center gap-1 text-primary-400 hover:text-primary-300 transition-colors duration-150 cursor-pointer"
  >
    <Icon name="ri:shield-keyhole-line" class="h-3 w-3" />
    {isRO ? "Solicită acces la CV" : "Request CV access"}
  </a>
</Card>
