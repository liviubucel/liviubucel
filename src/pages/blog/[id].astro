---
import { sanityClient } from "sanity:client";
import { PortableText } from "astro-portabletext";
import LayoutBlogPost from "../../layouts/LayoutBlogPost.astro";
import { SITE } from "../../site-config";

export const prerender = true;

export async function getStaticPaths() {
  let posts = [];
  try {
    posts = await sanityClient.fetch(`*[_type == "post"] { "id": slug.current }`);
  } catch (error) {
    console.error("Sanity error fetching paths:", error);
  }
  
  if (!posts || posts.length === 0) {
    return [{ params: { id: "placeholder" } }];
  }

  return posts.map(({ id }) => ({
    params: { id },
  }));
}

const { id } = Astro.params;

let entry = null;
try {
  entry = await sanityClient.fetch(`*[_type == "post" && slug.current == $id][0]`, { id });
} catch(e) {
  console.error(e);
}

if (!entry) {
  if (id === "placeholder") {
    entry = { title: "Placeholder", pubDate: new Date().toISOString(), description: "Placeholder", body: [] };
  } else {
    return Astro.redirect("/404");
  }
}
---

<LayoutBlogPost
  description={entry.description || ""}
  minutesRead="5 min read"
  pubDate={entry.pubDate ? new Date(entry.pubDate) : new Date()}
  title={`${entry.title} | ${SITE.author.fullName}`}
  url={`blog/${id}`}
>
  <PortableText value={entry.body} />
</LayoutBlogPost>

<style is:global>
  h1, h2, h3, h4, h5, h6 {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-weight: bold;
    color: var(--darkslate-100, #f8fafc);
  }
  h1 { font-size: 2.25rem; line-height: 2.5rem; }
  h2 { font-size: 1.875rem; line-height: 2.25rem; }
  h3 { font-size: 1.5rem; line-height: 2rem; }
  h4 { font-size: 1.25rem; line-height: 1.75rem; }
  h5 { font-size: 1.125rem; line-height: 1.5rem; }
  h6 { font-size: 1rem; line-height: 1.5rem; }
  
  p {
    margin-bottom: 1.25rem;
    color: var(--darkslate-300, #cbd5e1);
    line-height: 1.75;
  }
  
  a {
    color: var(--primary-500, #facc15);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
  }
  a:hover {
    color: var(--primary-400, #fde047);
  }
  
  ul, ol {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
    color: var(--darkslate-300, #cbd5e1);
  }
  li {
    margin-bottom: 0.5rem;
  }
  
  blockquote {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 4px solid var(--primary-500, #facc15);
    font-style: italic;
    color: var(--darkslate-400, #94a3b8);
  }
  
  pre, code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    background-color: var(--darkslate-800, #1e293b);
    border-radius: 0.375rem;
  }
  pre {
    padding: 1rem;
    overflow-x: auto;
    border: 1px solid var(--darkslate-700, #334155);
    margin-bottom: 1.5rem;
  }
  code {
    padding: 0.2rem 0.4rem;
    font-size: 0.875em;
    color: var(--primary-400, #fde047);
  }
  pre code {
    padding: 0;
    color: inherit;
    background-color: transparent;
  }
  
  img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }
  
  table {
    border-collapse: collapse;
    width: 100%;
    margin-bottom: 1.5rem;
    color: var(--darkslate-300, #cbd5e1);
  }
  th, td {
    text-align: left;
    padding: 0.75rem;
    border-bottom: 1px solid var(--darkslate-700, #334155);
  }
  th {
    font-weight: 600;
    color: var(--darkslate-100, #f8fafc);
  }
</style>
