---
import { DEFAULT_LANGUAGE, type Language } from '../lib/i18n';

interface Props {
  currentLang: Language;
  pathname: string;
}

const { currentLang, pathname } = Astro.props;

const getLanguageUrl = (lang: Language): string => {
  // Remove only the actual Romanian locale prefix (/ro or /ro/...), never
  // words that merely start with "ro" such as /romania-cyber-monitor.
  const cleanPath = pathname.replace(/^\/ro(?=\/|$)/, '');
  const targetPath = lang === DEFAULT_LANGUAGE ? cleanPath || '/' : `/${lang}${cleanPath}` || `/${lang}`;

  // Middleware consumes this one-time query parameter, stores the user's
  // explicit choice in a first-party cookie, then redirects to the clean URL.
  return `${targetPath}${targetPath.includes('?') ? '&' : '?'}lang=${lang}`;
};
---

<div class="language-switcher">
  <button
    class="lang-toggle"
    aria-label={currentLang === 'en' ? 'Switch to Romanian' : 'Switch to English'}
    title={currentLang === 'en' ? 'RO' : 'EN'}
  >
    <svg class="globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="10"></circle>
      <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span class="code">{currentLang.toUpperCase()}</span>
  </button>

  <div class="lang-dropdown">
    <a
      href={getLanguageUrl('en')}
      class:list={['lang-item', { active: currentLang === 'en' }]}
    >
      <span class="lang-flag">🇺🇸</span>
      <div>
        <div class="lang-name">English</div>
        <div class="lang-native">English</div>
      </div>
    </a>
    <a
      href={getLanguageUrl('ro')}
      class:list={['lang-item', { active: currentLang === 'ro' }]}
    >
      <span class="lang-flag">🇷🇴</span>
      <div>
        <div class="lang-name">Română</div>
        <div class="lang-native">Romanian</div>
      </div>
    </a>
  </div>
</div>

<style>
  .language-switcher {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 40;
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 56px;
    height: 56px;
    padding: 0;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    font-weight: 600;
    font-size: 0.75rem;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    backdrop-filter: blur(10px);
    font-family: system-ui, -apple-system, sans-serif;
  }

  .lang-toggle:hover {
    background: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.4);
    color: rgba(255, 255, 255, 0.9);
    transform: scale(1.08);
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.1);
  }

  .lang-toggle:active {
    transform: scale(0.95);
  }

  .globe {
    width: 20px;
    height: 20px;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .code {
    display: none;
    letter-spacing: 0.05em;
  }

  @media (max-width: 640px) {
    .language-switcher {
      bottom: 1rem;
      right: 1rem;
    }

    .lang-toggle {
      width: 48px;
      height: 48px;
    }

    .globe {
      display: none;
    }

    .code {
      display: block;
    }
  }

  .lang-dropdown {
    position: absolute;
    bottom: 100%;
    right: 0;
    margin-bottom: 1rem;
    background: rgba(15, 23, 42, 0.98);
    border: 1px solid rgba(250, 204, 21, 0.2);
    border-radius: 12px;
    overflow: hidden;
    min-width: 200px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    backdrop-filter: blur(20px);
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }

  .language-switcher:hover .lang-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .lang-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.125rem;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: all 0.2s ease;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    cursor: pointer;
  }

  .lang-item:last-child {
    border-bottom: none;
  }

  .lang-item:hover {
    background: rgba(250, 204, 21, 0.08);
    color: #facc15;
  }

  .lang-item.active {
    background: rgba(250, 204, 21, 0.15);
    color: #facc15;
  }

  .lang-flag {
    font-size: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
  }

  .lang-name {
    font-size: 0.9rem;
    font-weight: 500;
  }

  .lang-native {
    font-size: 0.75rem;
    opacity: 0.6;
  }

  @media (max-width: 640px) {
    .lang-dropdown {
      min-width: 160px;
    }

    .lang-item {
      padding: 0.75rem 1rem;
    }

    .lang-name {
      font-size: 0.85rem;
    }

    .lang-native {
      display: none;
    }
  }
</style>
