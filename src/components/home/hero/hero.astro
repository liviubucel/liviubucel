---
import AvailabilityBadge from '@/components/shared/availability-badge'
import GreetingWord from '@/components/home/hero/greeting-word'
import HeroCta from '@/components/home/hero/hero-cta'
import IdCard from '@/components/ui/id-card'
---

<section class='lg:relative' data-hero-id-card>
  <div class='border-b pb-8 max-sm:pt-20 sm:py-16 lg:pt-32 lg:pb-24'>
    <div class='px-4 sm:px-6 lg:px-10.5'>
      <div class='space-y-6 lg:max-w-[34rem]'>
        <AvailabilityBadge className='h-6.5 gap-1 rounded-full' />
        <h1 class='mb-2 text-4xl font-semibold tracking-tight sm:text-5xl lg:text-[60px] lg:font-bold lg:leading-[1.02]'>
          <GreetingWord client:load /><span class='whitespace-nowrap'>I’m Liviu 👋🏻</span>
        </h1>
        <p class='text-muted-foreground text-xl font-medium sm:text-2xl lg:text-3xl'>Cybersecurity & DFIR</p>
        <p class='mb-8 max-w-2xl text-base'>
          I work across ethical hacking, digital investigation and practical security research, from understanding attack paths to analysing incidents and hardening systems.
        </p>
        <HeroCta />
      </div>
    </div>
  </div>

  <!--
    Server-rendered safety net for the WebGL badge. It stays visible if the browser cannot
    initialise WebGL/Rapier and fades only after a live WebGL context is present. This prevents
    the large empty hero column seen when the client-only canvas cannot start.
  -->
  <div
    id='hero-id-card-fallback'
    aria-hidden='true'
    class='pointer-events-none absolute top-14 right-12 z-[5] hidden h-[34rem] w-[19rem] transition-[opacity,transform,visibility] duration-500 lg:block'
  >
    <div class='absolute top-0 left-1/2 h-32 w-px -translate-x-1/2 bg-linear-to-b from-transparent via-foreground/30 to-foreground/60'></div>
    <div class='absolute top-[7.25rem] left-1/2 z-20 h-11 w-8 -translate-x-1/2'>
      <img src='/images/3d-card/pin.webp' alt='' class='size-full object-contain drop-shadow-md' />
    </div>
    <div class='bg-background ring-border absolute top-36 left-1/2 w-[15.75rem] -translate-x-1/2 rotate-[2deg] overflow-hidden rounded-[18px] shadow-2xl ring-1'>
      <div class='h-2 bg-[#ff5c00]'></div>
      <div class='relative aspect-[4/4.55] overflow-hidden bg-neutral-950'>
        <img src='/images/3d-card/profile.webp' alt='' class='size-full object-cover' />
        <div class='absolute inset-x-0 bottom-0 bg-linear-to-t from-black/80 via-black/25 to-transparent px-5 pt-16 pb-5 text-white'>
          <p class='text-lg font-semibold tracking-tight'>Liviu Bucel</p>
          <p class='mt-0.5 text-xs text-white/70'>Cybersecurity & DFIR</p>
        </div>
      </div>
      <div class='flex items-center justify-between gap-3 px-5 py-4'>
        <div>
          <p class='text-[10px] uppercase tracking-[0.16em] text-muted-foreground'>Focus</p>
          <p class='mt-1 text-xs font-medium'>Investigate · Test · Harden</p>
        </div>
        <span class='size-2 rounded-full bg-emerald-500 shadow-[0_0_0_4px_rgba(34,197,94,.12)]'></span>
      </div>
    </div>
  </div>

  <!-- client:only — WebGL/Canvas can't SSR -->
  <IdCard
    client:only='react'
    frontImage='/images/3d-card/profile.webp'
    className='mx-auto mt-8 aspect-4/5 w-full max-w-80 max-lg:hidden lg:absolute lg:-top-31 lg:right-0 lg:left-0 lg:z-10 lg:mt-0 lg:aspect-auto lg:h-192 lg:max-w-none'
  />

  <script is:inline>
    ;(() => {
      const initHeroCardFallback = () => {
        const section = document.querySelector('[data-hero-id-card]')
        const fallback = document.getElementById('hero-id-card-fallback')
        if (!section || !fallback || fallback.dataset.observing === 'true') return

        fallback.dataset.observing = 'true'
        let hideTimer

        const canvasIsLive = () => {
          const canvas = section.querySelector('canvas')
          if (!canvas) return false

          try {
            const gl = canvas.getContext('webgl2') || canvas.getContext('webgl')
            return Boolean(gl && !gl.isContextLost())
          } catch {
            return false
          }
        }

        const check = () => {
          if (!canvasIsLive()) return
          clearTimeout(hideTimer)
          hideTimer = window.setTimeout(() => {
            fallback.dataset.canvasReady = 'true'
          }, 900)
        }

        const observer = new MutationObserver(check)
        observer.observe(section, { childList: true, subtree: true })
        check()

        window.setTimeout(() => observer.disconnect(), 12000)
      }

      document.addEventListener('astro:page-load', initHeroCardFallback)
      initHeroCardFallback()
    })()
  </script>

  <style>
    #hero-id-card-fallback[data-canvas-ready='true'] {
      opacity: 0;
      visibility: hidden;
      transform: translateY(8px) scale(0.98);
    }
  </style>
</section>
