---
import Card from "./Card/index.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../site-config";

interface Props {
  lang?: "en" | "ro";
}

const { lang = "en" } = Astro.props;
const isRO = lang === "ro";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  title={isRO ? "Profil profesional" : "Professional profile"}
  href={SITE.links.linkedin}
>
  <div class="flex flex-col gap-2 mt-4 h-full">
    <p class="text-sm text-darkslate-300 m-0">
      {isRO
        ? "Experiență, educație și parcurs profesional."
        : "Experience, education, and professional background."}
    </p>
    <div class="flex items-center gap-2 text-primary-500 mt-auto font-bold">
      <Icon name="ri:linkedin-box-fill" class="h-5 w-5" />
      {isRO ? "Vezi LinkedIn" : "View LinkedIn"}
    </div>
  </div>
</Card>
