---
import Card from "./Card/index.astro";
import { SITE } from "../site-config";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-6" title="About me">
  <div class="flex flex-col gap-2">
    <p class="sr-only">
      Hi, I'm {SITE.author.firstName}, a BSc Cyber Security student at De Montfort University in the {SITE.location.countryName}.
      My areas of interest include Ethical Hacking, Digital Forensics, Cryptography, and SOC analysis.
      I'm building practical experience through CTFs, personal projects, and security research.
    </p>
    <div aria-hidden="true" class="text-sm font-light">
      <p class="text-sm font-light">
        Hi, I'm {SITE.author.firstName}, a BSc Cyber Security student at DMU in the {SITE.location.countryName}.
      </p>
      <br />
      Areas of interest:
      <ul class="list-disc list-inside">
        <li>Ethical Hacking</li>
        <li>Digital Forensics</li>
        <li>Cryptography</li>
        <li>SOC Analysis</li>
        <li>Penetration Testing</li>
        <li>Incident Response</li>
      </ul>
      <p class="text-sm font-light mt-2">
        Building practical skills through CTFs, personal security projects, and continuous learning.
      </p>
    </div>
  </div>
</Card>
