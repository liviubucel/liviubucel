---
import Card from "./Card/index.astro";
import Button from "./Button.astro";
import { LINKS } from "../lib/constants";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import { SITE } from "../site-config";
import { getProfileSettings, type ProfileSettings } from "../lib/sanity-queries";
import MemojiAvatarDefault from "../assets/me.webp";
import MemojiAvatarBlue from "../assets/me-blue.webp";
import MemojiAvatarGreen from "../assets/me-green.webp";
import MemojiAvatarPurple from "../assets/me-purple.webp";
import MemojiAvatarYellow from "../assets/me-yellow.webp";

interface Props {
  fullName?: string;
  role?: string;
  tagline?: string;
  github?: string;
  linkedin?: string;
  lang?: "en" | "ro";
  /** Pass this down from the page when it's already been fetched there
   * (e.g. alongside ContactsCard/Now's own need for it) to avoid firing
   * the same Sanity query multiple times per page render. Falls back to
   * fetching it itself so the component still works standalone. */
  profile?: ProfileSettings | null;
}

const {
  profile: profileProp,
  github: githubProp,
  linkedin: linkedinProp,
  lang = "en",
} = Astro.props;

const profile = profileProp !== undefined ? profileProp : await getProfileSettings();
const github = githubProp ?? profile?.github ?? LINKS.github;
const linkedin = linkedinProp ?? profile?.linkedin ?? LINKS.linkedin;

const isRO = lang === "ro";
const heading = isRO ? "Sunt Liviu Bucel" : "I'm Liviu Bucel";
const roleText = isRO
  ? "Securitate cibernetică · Ethical Hacking · Investigații digitale"
  : "Cybersecurity · Ethical Hacking · Digital Investigation";
const summaryText = isRO
  ? "Mă interesează cum funcționează atacurile, cum sunt descoperite vulnerabilitățile și cum pot fi investigate incidentele. Aici îmi prezint proiectele și activitatea tehnică."
  : "I'm interested in how attacks work, how vulnerabilities are found, and how incidents can be investigated. This is where I share my projects and technical work.";
const mottoText = isRO
  ? "FĂ-O, DAR FĂ-O BINE!"
  : "JUST DO IT, BUT DO IT WELL!";

const twitter = profile?.twitter;
const youtube = profile?.youtube;
const tryhackme = profile?.tryhackme;
---

<Card colSpan="md:col-span-3" rowSpan="md:row-span-4">
  <div class="flex w-full h-full">
    <div class="flex flex-col justify-between md:max-h-[300px] gap-4 min-w-0">
      <div class="flex flex-col h-full">
        <p class="text-sm font-light m-0 text-darkslate-300">{roleText}</p>
        <h1 class="text-3xl sm:text-4xl font-bold m-0 mt-1">{heading}</h1>
        <p class="m-0 font-light text-md mt-3">{summaryText}</p>
        <p class="text-sm font-bold mt-auto">{mottoText}</p>
      </div>
      <div class="flex gap-2 lg:gap-4">
        <a href={github} aria-label="github profile" target="_blank">
          <Button aria-label="github profile">
            <Icon name="ri:github-fill" />
            <span class="sr-only" data-umami-event="github button"
              >GitHub Profile</span
            >
          </Button>
        </a>
        <a
          href={linkedin}
          aria-label="linkedin profile"
          target="_blank"
        >
          <Button aria-label="linkedin profile">
            <Icon name="ri:linkedin-box-fill" />
            <span class="sr-only" data-umami-event="linkedin button"
              >Linkedin Profile</span
            >
          </Button>
        </a>
        {twitter && (
          <a href={twitter} aria-label="x profile" target="_blank">
            <Button aria-label="x profile">
              <Icon name="ri:twitter-x-fill" />
              <span class="sr-only" data-umami-event="x button">X Profile</span>
            </Button>
          </a>
        )}
        {youtube && (
          <a href={youtube} aria-label="youtube channel" target="_blank">
            <Button aria-label="youtube channel">
              <Icon name="ri:youtube-fill" />
              <span class="sr-only" data-umami-event="youtube button">YouTube Channel</span>
            </Button>
          </a>
        )}
        {tryhackme && (
          <a href={tryhackme} aria-label="tryhackme profile" target="_blank">
            <Button aria-label="tryhackme profile">
              <Icon name="simple-icons:tryhackme" />
              <span class="sr-only" data-umami-event="tryhackme button">TryHackMe Profile</span>
            </Button>
          </a>
        )}
      </div>
    </div>
    <Image
      id="memoji-avatar"
      quality="max"
      src={MemojiAvatarDefault}
      data-theme-default={MemojiAvatarDefault.src}
      data-theme-yellow-theme={MemojiAvatarYellow.src}
      data-theme-blue-theme={MemojiAvatarBlue.src}
      data-theme-green-theme={MemojiAvatarGreen.src}
      data-theme-purple-theme={MemojiAvatarPurple.src}
      class="w-auto max-h-[300px] select-none absolute right-[-110px] bottom-[-20px] z-[-1] opacity-50 md:opacity-100 md:relative md:right-auto md:bottom-auto md:z-auto pointer-events-none grayscale"
      alt={`memoji of ${SITE.author.firstName}`}
      loading="eager"
    />
  </div>
</Card>

<script>
  import { animate } from "motion";

  function updateMemojiImage() {
    const avatarImg = document.getElementById(
      "memoji-avatar"
    ) as HTMLImageElement;
    if (!avatarImg) return;

    const theme = localStorage.getItem("theme") || "default";
    const themeClass = theme === "default" ? "default" : theme;
    const imageSrc =
      avatarImg.getAttribute(`data-theme-${themeClass}`) ||
      avatarImg.getAttribute("data-theme-default");

    if (imageSrc && avatarImg.src !== imageSrc) {
      avatarImg.src = imageSrc;
      if (avatarImg.srcset) {
        avatarImg.srcset = "";
      }
    }
  }

  function initLevitatingAnimation() {
    const avatarImg = document.getElementById("memoji-avatar") as HTMLElement;
    if (!avatarImg) return;

    animate(
      avatarImg,
      { y: [-10, 10, -10] },
      {
        duration: 3,
        repeat: Infinity,
        ease: "easeInOut",
      }
    );
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => {
      updateMemojiImage();
      initLevitatingAnimation();
    });
  } else {
    updateMemojiImage();
    initLevitatingAnimation();
  }

  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      if (
        mutation.type === "attributes" &&
        mutation.attributeName === "class"
      ) {
        updateMemojiImage();
      }
    });
  });

  if (document.body) {
    observer.observe(document.body, {
      attributes: true,
      attributeFilter: ["class"],
    });
  } else {
    document.addEventListener("DOMContentLoaded", () => {
      observer.observe(document.body, {
        attributes: true,
        attributeFilter: ["class"],
      });
      updateMemojiImage();
    });
  }

  document.addEventListener("themechange", updateMemojiImage);
</script>
