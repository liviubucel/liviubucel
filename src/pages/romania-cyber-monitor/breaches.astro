---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import Seo from '../../components/Seo.astro';
import SectionNav from '../../components/CyberMonitor/SectionNav.astro';
import IncidentCard from '../../components/CyberMonitor/IncidentCard.astro';
import { listPublicIncidents } from '../../lib/cyber-monitor/public-data';
import { SITE } from '../../site-config';

export const prerender = false;

let incidents: Awaited<ReturnType<typeof listPublicIncidents>> = [];
try {
  incidents = await listPublicIncidents(env.ROMANIA_MONITOR_DB, { recordType: 'verified_breach', limit: 50 });
} catch (error) {
  console.error('[romania-cyber-monitor/breaches] failed to load incidents:', error);
}

const title = 'Breaches | Romania Cyber Monitor';
const description =
  'Data breaches in the Have I Been Pwned catalogue matched to a verified Romanian organisation domain, with verification status stated for each entry.';
---

<Layout title={title} description={description} lang="en">
  <Seo title={title} description={description} lang="en" canonical={`${SITE.site.url}romania-cyber-monitor/breaches`} />
  <main class="w-screen min-h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8">
    <a class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg" href="/">Back</a>
    <h1 class="text-4xl font-bold mb-2 text-neutral-100">Breaches</h1>
    <p class="text-darkslate-200 mb-6 max-w-2xl">
      Breach catalogue entries matched to a verified Romanian organisation domain. Verification status
      reflects the source catalogue's own process, not confirmation by a Romanian authority.
    </p>
    <SectionNav active="breaches" />
    {incidents.length === 0 ? (
      <p class="text-darkslate-300">No published breaches yet.</p>
    ) : (
      <ul class="w-full">{incidents.map((incident) => <IncidentCard incident={incident} />)}</ul>
    )}
  </main>
</Layout>
