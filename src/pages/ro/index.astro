---
import { DEFAULT_LANGUAGE, type Language } from '../../lib/i18n';
import Seo from '../../components/Seo.astro';
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card/index.astro";
import IntroCard from "../../components/IntroCard.astro";
import ContactsCard from "../../components/ContactsCard.astro";
import DonateCard from "../../components/DonateCard.astro";
import TimeZone from "../../components/TimeZoneCard.astro";
import AboutMe from "../../components/AboutMe.astro";
import Now from "../../components/Now.astro";
import CyberStatsCard from "../../components/CyberStatsCard.astro";
import DesignWorksCard from "../../components/DesignWorksCard.astro";
import MyStack from "../../components/MyStack.astro";
import { SITE } from "../../site-config";
import { sanityClient } from "../../lib/sanity";

const lang: Language = 'ro';
const isRO = true;

// Fetch all data from Sanity once
let homepage = null;
let techStack = [];
let socialLinks = [];
let cyberStats = null;

try {
  [homepage, techStack, socialLinks, cyberStats] = await Promise.all([
    sanityClient.fetch(`*[_type == "homepage"][0]`),
    sanityClient.fetch(`*[_type == "techStack"] | order(order asc)`),
    sanityClient.fetch(`*[_type == "socialLink"] | order(order asc)`),
    sanityClient.fetch(`*[_type == "cyberStats"][0]`),
  ]);
} catch (e) {
  console.error("Sanity fetch error:", e);
}

// Fallbacks from site-config if Sanity is empty
const fullName = homepage?.fullName || SITE.author.fullName;
const role = homepage?.role || SITE.author.jobTitle;
const tagline = homepage?.tagline || "";
const aboutText = homepage?.aboutText || null;
const email = homepage?.email || SITE.links.email;
const location = homepage?.location || SITE.location.countryName;
const github = socialLinks.find(s => s.platform === "GitHub")?.url || SITE.links.github;
const linkedin = socialLinks.find(s => s.platform === "LinkedIn")?.url || SITE.links.linkedin;
---

<Layout
  description={`${role} din ${location}. ${tagline}`}
  title={`${fullName} - ${role}`}
  lang={lang}
>
  <Seo
    title={`${fullName} - ${role}`}
    description={`${role} din ${location}. ${tagline}`}
    lang={lang}
    type="profile"
    keywords={["cyber security", "web development", "frontend", "security"]}
    canonical={`${SITE.site.url}ro`}
  />

  <main
    class="text-white m-auto p-2 grid gap-2 max-w-6xl overflow-hidden relative w-full sm:p-4 sm:gap-2 md:grid-cols-2 md:gap-3 md:p-6 lg:h-screen lg:grid-rows-8 lg:grid-cols-4 lg:gap-4 lg:max-h-[800px]"
  >
    <IntroCard fullName={fullName} role={role} tagline={tagline} github={github} linkedin={linkedin} lang={lang} />
    <AboutMe aboutText={aboutText} fullName={fullName} location={location} lang={lang} />
    <ContactsCard email={email} location={location} github={github} linkedin={linkedin} lang={lang} />
    <TimeZone lang={lang} />
    <MyStack techStack={techStack} />
    <Now lang={lang} />
    <Card
      href="/ro/playground"
      colSpan="md:col-span-1"
      rowSpan="md:row-span-1"
      title="Expozitie"
    />
    <Card
      href="/ro/guestbook"
      colSpan="md:col-span-1"
      rowSpan="md:row-span-1"
      title="Cartea de Oaspeti"
    />
    <Card
      href="/ro/blog"
      colSpan="md:col-span-1"
      rowSpan="md:row-span-1"
      title="Blog"
    />
    <CyberStatsCard stats={cyberStats?.stats} lang={lang} />
    <DonateCard lang={lang} />

    <Card colSpan="md:col-span-1" rowSpan="md:row-span-1">
      <p class="text-xs">
        © 2025 · Creat cu 🤍 folosind <a
          class="text-primary-500"
          href="https://astro.build/"
          target="_blank">Astro</a
        > de mine.
      </p>
    </Card>
  </main>
</Layout>

<script>
  import { stagger, animate, type AnimationSequence } from "motion";
  import { loaderAnimation } from "../../lib/constants";
  const cards = document.querySelectorAll(".card");

  const sequence = [
    loaderAnimation,
    [
      cards,
      { y: ["40%", "0%"], opacity: [0, 1] },
      {
        type: "spring",
        at: "-0.1",
        delay: stagger(0.2),
      },
    ],
  ] as AnimationSequence;

  animate(sequence);
</script>
