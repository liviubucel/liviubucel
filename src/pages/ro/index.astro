---
import { DEFAULT_LANGUAGE, type Language } from '../../lib/i18n';
import Seo from '../../components/Seo.astro';
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card/index.astro";
import IntroCard from "../../components/IntroCard.astro";
import ContactsCard from "../../components/ContactsCard.astro";
import DonateCard from "../../components/DonateCard.astro";
import TimeZone from "../../components/TimeZoneCard.astro";
import AboutMe from "../../components/AboutMe.astro";
import Now from "../../components/Now.astro";
import DesignWorksCard from "../../components/DesignWorksCard.astro";
import NewsletterSignup from "../../components/NewsletterSignup.astro";
import { SITE } from "../../site-config";
import { getPageSeo } from "../../lib/sanity-queries";

const lang: Language = 'ro';
const isRO = true;
const newsletterStatus = Astro.url.searchParams.get('newsletter');

const seo = await getPageSeo("home-ro");
const seoTitle = seo?.title || `${SITE.author.fullName} - ${SITE.author.jobTitle}`;
const seoDescription = seo?.description || "Portofoliu de securitate cibernetică axat pe ethical hacking, investigații digitale, răspuns la incidente și testare de securitate";
const seoKeywords = seo?.keywords || ["securitate cibernetică", "criminalistică digitală", "răspuns la incidente", "testare de penetrare", "evaluarea vulnerabilităților"];
---

<Layout
  description={seoDescription}
  title={seoTitle}
  lang={lang}
>
  <Seo
    title={seoTitle}
    description={seoDescription}
    lang={lang}
    type="profile"
    keywords={seoKeywords}
    ogImage={seo?.ogImage}
    canonical={`${SITE.site.url}ro/`}
  />

  <main
    class="text-white m-auto p-2 grid gap-2 max-w-6xl overflow-hidden relative w-full sm:p-4 sm:gap-2 md:grid-cols-2 md:gap-3 md:p-6 lg:h-[800px] lg:grid-rows-8 lg:grid-cols-4 lg:gap-4"
  >
    <IntroCard lang={lang} />
    <AboutMe lang={lang} />
    <ContactsCard lang={lang} />
    <TimeZone lang={lang} />
    <DesignWorksCard lang={lang} />
    <Now lang={lang} />
    <Card
      href="/ro/contact"
      colSpan="md:col-span-1"
      rowSpan="md:row-span-1"
      title="Contact"
    />
    <Card
      href="/ro/blog"
      colSpan="md:col-span-1"
      rowSpan="md:row-span-1"
      title="Blog"
    />
    <DonateCard lang={lang} />

    <Card colSpan="md:col-span-1" rowSpan="md:row-span-1" padding="p-4 md:p-3">
      <div class="flex flex-col h-full justify-center gap-1.5 md:gap-1">
        <p class="text-xs md:text-[11px] leading-snug">
          © 2025 · Creat cu ♥️ folosind <a
            class="text-red-500"
            href="https://astro.build/"
            target="_blank">Astro</a
          > de mine. · <a class="text-darkslate-200 hover:text-primary-400 underline" href="/ro/privacy">Politica de confidențialitate</a>
        </p>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <a href="/" class="flex items-center gap-1 text-xs md:text-[11px] text-darkslate-300 hover:text-primary-400 transition-colors duration-150">
            <span aria-hidden="true">🇺🇸</span> EN
          </a>
          <span aria-current="true" class="flex items-center gap-1 text-xs md:text-[11px] text-neutral-100 font-semibold">
            <span aria-hidden="true">🇷🇴</span> RO
          </span>
        </div>
      </div>
    </Card>

    <NewsletterSignup initialStatus={newsletterStatus} lang={lang} />
  </main>
</Layout>

<script>
  import { stagger, animate, type AnimationSequence } from "motion";
  import { loaderAnimation } from "../../lib/constants";
  const cards = document.querySelectorAll(".card");

  const sequence = [
    loaderAnimation,
    [
      cards,
      { y: ["40%", "0%"], opacity: [0, 1] },
      {
        type: "spring",
        at: "-0.1",
        delay: stagger(0.2),
      },
    ],
  ] as AnimationSequence;

  animate(sequence);
</script>
