---
import Card from "./Card/index.astro";
import { LINKS } from "../lib/constants";
import { SITE } from "../site-config";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4">
  <div class="h-full">
    <header class="flex items-center">
      <h2 class="text-white text-xl font-bold">
        Open to Opportunities
      </h2>
    </header>
    <div class="flex flex-col mt-4">
      <p class="text-sm text-darkslate-300">Open to graduate, internship and junior opportunities in cybersecurity, digital forensics and security operations.</p>
      <address class="flex flex-col mt-3 not-italic">
        <p class="text-sm">{SITE.links.email}</p>
        <p class="text-sm">{SITE.location.countryName}</p>
      </address>
    </div>
  </div>
</Card>
