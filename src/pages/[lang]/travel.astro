---
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE, type Language } from '../../lib/i18n';
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../site-config';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Language };
const isRO = lang === 'ro';
---

<Layout
  description={isRO ? "Țările pe care le-am vizitat" : "Countries I've visited"}
  title={`${SITE.author.fullName} - ${isRO ? 'Călătorii' : 'Travel'}`}
  lang={lang}
>
  <main class="w-screen min-h-screen flex flex-col justify-center items-center max-w-4xl mx-auto p-8">
    <a
      class="absolute top-8 left-8 text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 border-1 border-solid border-neutral-600 rounded-lg"
      href={lang === DEFAULT_LANGUAGE ? '/' : `/${lang}/`}>Back</a
    >
    <h1 class="text-4xl font-bold mb-8 text-neutral-100">
      {isRO ? 'Țările pe care le-am vizitat' : 'Countries I\'ve Visited'}
    </h1>
    <div class="text-neutral-400 text-center">
      {isRO ? (
        <p>Am vizitat: <strong>{SITE.visitedCountries.join(', ')}</strong></p>
      ) : (
        <p>I've visited: <strong>{SITE.visitedCountries.join(', ')}</strong></p>
      )}
    </div>
  </main>
</Layout>
