---
import Card from "./Card/index.astro";
import { SITE } from "../site-config";
import { PortableText } from "astro-portabletext";

interface Props {
  fullName?: string;
  location?: string;
  aboutText?: any[];
}

const {
  fullName = SITE.author.fullName,
  location = SITE.location.countryName,
  aboutText = null,
} = Astro.props;

const firstName = fullName?.split(" ")[0] || SITE.author.firstName;
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-6" title="About me">
  <div class="flex flex-col gap-2">
    {aboutText ? (
      <div class="text-sm font-light prose prose-invert prose-sm max-w-none">
        <PortableText value={aboutText} />
      </div>
    ) : (
      <div aria-hidden="true" class="text-sm font-light">
        <p class="text-sm font-light">
          Hi, I'm {firstName}, a Cyber Security Specialist from {location}.
        </p>
        <br />
        My primary areas of expertise:
        <ul class="list-disc list-inside">
          <li>Ethical Hacking</li>
          <li>Digital Forensics</li>
          <li>Cryptography</li>
          <li>Penetration Testing</li>
          <li>Security Assessments</li>
          <li>Vulnerability Research</li>
        </ul>
        <p class="text-sm font-light mt-2">
          I hold a degree from DMU (De Montfort University).
        </p>
        <p class="text-sm font-light mt-2">
          My mission is to help organizations and individuals stay secure in an ever-changing digital world by combining academic expertise with practical skills.
        </p>
      </div>
    )}
  </div>
</Card>
