---
import Card from "./Card/index.astro";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  title="Cyber Security"
  href="/projects"
>
  <div class="flex flex-col gap-3 mt-4">
    <div class="flex items-center gap-3">
      <div class="text-xl">🐛</div>
      <div class="flex flex-col">
        <span class="font-bold text-sm text-neutral-100">50+ Vulnerabilities</span>
        <span class="text-xs text-darkslate-300">Found and reported</span>
      </div>
    </div>
    
    <div class="flex items-center gap-3">
      <div class="text-xl">🏆</div>
      <div class="flex flex-col">
        <span class="font-bold text-sm text-neutral-100">OSCP & CEH</span>
        <span class="text-xs text-darkslate-300">Certifications</span>
      </div>
    </div>
    
    <div class="flex items-center gap-3">
      <div class="text-xl">🛡️</div>
      <div class="flex flex-col">
        <span class="font-bold text-sm text-neutral-100">Zebrabyte</span>
        <span class="text-xs text-darkslate-300">Agency Founder</span>
      </div>
    </div>
  </div>
</Card>
