---
import { DEFAULT_LANGUAGE, type Language } from '../../lib/i18n';
import Seo from '../../components/Seo.astro';
import { getPosts } from '../../lib/sanity-queries';
import Layout from '../../layouts/Layout.astro';
import PostRow from '../../components/Blog/PostRow.astro';
import { SITE } from '../../site-config';

const lang: Language = 'en';
const isRO = false;

let posts = [];
let debugError = "";
try {
    const allPosts = await getPosts(lang);
    posts = allPosts.filter(p => p.published).map(p => ({
      id: p.slug,
      title: p.title,
      pubDate: p.pubDate
    }));
} catch (error) {
  debugError = error instanceof Error ? error.message : String(error);
  console.warn('Sanity client error (during prerender, this may be expected):', error);
}
---

<script>
  import { animate, type AnimationSequence } from 'motion';
  import { loaderAnimation } from '../../lib/constants';

  const sequence = [loaderAnimation];

  animate(sequence as AnimationSequence);
</script>

<Layout
  description="Software developer with strong focus on the user experience animations and micro interactions"
  title={`${SITE.author.fullName} - Blog`}
  lang={lang}
>
  <Seo
    title={`${SITE.author.fullName} - Blog`}
    description="Software developer with strong focus on the user experience animations and micro interactions"
    lang={lang}
    canonical={`${SITE.site.url}blog`}
  />
  <main
    class="w-screen h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8"
  >
    <a
      class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg"
      href="/">Back</a
    >
    <h1 class="text-4xl font-bold mb-4 text-neutral-100">
      Posts
    </h1>
    
    <div style="background: red; padding: 10px; margin-bottom: 20px;">
      <p>Debug Sanity API:</p>
      <pre>{JSON.stringify(posts || [], null, 2)}</pre>
      {debugError && <p style="color: white; font-weight: bold;">Error: {debugError}</p>}
    </div>

    <ul class="w-full">
      {
        posts?.map((post) => (
          <PostRow
            date={post.pubDate ? new Date(post.pubDate) : new Date()}
            id={post.id}
            title={post.title || 'No title'}
            lang={lang}
          />
        ))
      }
    </ul>
  </main>
</Layout>
