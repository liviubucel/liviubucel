---
import Card from "./Card/index.astro";

interface Stat {
  _key?: string;
  label: string;
  value: string;
}

interface Props {
  stats?: Stat[];
}

const defaultStats: Stat[] = [
  { label: "Found and reported", value: "50+ Vulnerabilities" },
  { label: "Certifications", value: "OSCP & CEH" },
  { label: "Agency Founder", value: "Zebrabyte" },
];

const emojis = ["🐛", "🏆", "🛡️", "🔍", "📋", "🔒"];

const { stats = defaultStats } = Astro.props;
const displayStats = (stats && stats.length > 0) ? stats : defaultStats;
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  title="Cyber Security"
  href="/projects"
>
  <div class="flex flex-col gap-3 mt-4">
    {displayStats.map((stat, i) => (
      <div class="flex items-center gap-3">
        <div class="text-xl">{emojis[i % emojis.length]}</div>
        <div class="flex flex-col">
          <span class="font-bold text-sm text-neutral-100">{stat.value}</span>
          <span class="text-xs text-darkslate-300">{stat.label}</span>
        </div>
      </div>
    ))}
  </div>
</Card>
