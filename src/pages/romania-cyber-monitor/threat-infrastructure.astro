---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import Seo from '../../components/Seo.astro';
import SectionNav from '../../components/CyberMonitor/SectionNav.astro';
import { listPublicIndicators } from '../../lib/cyber-monitor/public-data';
import { SITE } from '../../site-config';

export const prerender = false;

let indicators: Awaited<ReturnType<typeof listPublicIndicators>> = [];
try {
  indicators = await listPublicIndicators(env.ROMANIA_MONITOR_DB, 50);
} catch (error) {
  console.error('[romania-cyber-monitor/threat-infrastructure] failed to load indicators:', error);
}

const title = 'Threat infrastructure | Romania Cyber Monitor';
const description =
  'Defanged threat indicators (malicious IPs, domains, URLs) with a documented Romania hosting link. Every value is defanged and never directly clickable.';
---

<Layout title={title} description={description} lang="en">
  <Seo title={title} description={description} lang="en" canonical={`${SITE.site.url}romania-cyber-monitor/threat-infrastructure`} />
  <main class="w-screen min-h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8">
    <a class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg" href="/">Back</a>
    <h1 class="text-4xl font-bold mb-2 text-neutral-100">Threat infrastructure</h1>
    <p class="text-darkslate-200 mb-6 max-w-2xl">
      Defanged threat indicators (malicious IPs, domains, URLs) with a documented Romania hosting
      link. Values are defanged (e.g. <code>hxxp://evil[.]example</code>) so this page is never a
      clickable list of live malicious infrastructure.
    </p>
    <SectionNav active="threat-infrastructure" />
    {indicators.length === 0 ? (
      <p class="text-darkslate-300">This data source is not yet enabled. Check back soon.</p>
    ) : (
      <ul class="w-full">
        {indicators.map((indicator) => (
          <li class="list-none w-full mb-3 bg-darkslate-500 border border-darkslate-400 rounded-lg p-4">
            <div class="flex flex-wrap justify-between gap-2">
              <code class="font-mono text-neutral-100 break-all">{indicator.defangedValue}</code>
              <span class="text-sm text-darkslate-300">{indicator.iocType}</span>
            </div>
            <div class="text-sm text-darkslate-200 mt-1">
              {indicator.malwareFamily && <span class="mr-3">Family: {indicator.malwareFamily}</span>}
              {indicator.lastSeen && <span>Last seen: {indicator.lastSeen}</span>}
            </div>
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>
