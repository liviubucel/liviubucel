---
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE, type Language } from '../../../lib/i18n';
import Layout from '../../../layouts/Layout.astro';
import { SITE } from '../../../site-config';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Language };
const isRO = lang === 'ro';

const playgrounds = [
  { slug: 'carousel', name: isRO ? 'Carusel' : 'Carousel' },
  { slug: 'future-scroll', name: isRO ? 'Scroll Futurist' : 'Future Scroll' },
  { slug: 'glowing-stars', name: isRO ? 'Stele Strălucitoare' : 'Glowing Stars' },
  { slug: 'rifle-1', name: 'Rifle 1' },
  { slug: 'sliding-images-loader', name: isRO ? 'Loader Imagini' : 'Sliding Images Loader' },
  { slug: 'turbulence-header', name: isRO ? 'Header Turbulent' : 'Turbulence Header' },
];
---

<Layout
  description={isRO ? "Expozitie interactivă cu animații și efecte" : "Interactive playground with animations and effects"}
  title={`${SITE.author.fullName} - ${isRO ? 'Expozitie' : 'Playground'}`}
  lang={lang}
>
  <main class="w-screen min-h-screen flex flex-col justify-start items-start max-w-4xl mx-auto p-8">
    <a
      class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg"
      href={lang === DEFAULT_LANGUAGE ? '/' : `/${lang}/`}>Back</a
    >
    <h1 class="text-4xl font-bold mb-8 text-neutral-100">
      {isRO ? 'Expozitie' : 'Playground'}
    </h1>
    <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 w-full">
      {playgrounds.map(pg => (
        <li>
          <a
            href={`${lang === DEFAULT_LANGUAGE ? '' : `/${lang}`}/playground/${pg.slug}`}
            class="block p-4 border border-neutral-600 rounded-lg hover:border-neutral-400 transition-colors"
          >
            {pg.name}
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
