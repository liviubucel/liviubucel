---
import Card from "./Card/index.astro";
import Button from "./Button.astro";
import { Icon } from "astro-icon/components";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-1" padding="p-4">
  <div class="flex flex-col h-full justify-center gap-3">
    <h2 class="text-white text-xl font-bold m-0">Experience</h2>
    <p class="text-xs text-darkslate-300 m-0">
      View my professional background and download CV.
    </p>
    <a href="/experience" class="mt-auto w-full">
      <Button class="w-full justify-center">
        <Icon name="ri:briefcase-line" class="mr-2" />
        View Experience
      </Button>
    </a>
  </div>
</Card>
