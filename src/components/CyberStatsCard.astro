---
import Card from "./Card/index.astro";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  title="Cyber Security"
  href="/projects"
>
  <div class="h-full w-full flex flex-col justify-center gap-2 mt-4">
    <div class="flex items-center gap-2 text-primary-500">
      <div class="text-2xl">🐛</div>
      <div class="flex flex-col">
        <span class="font-bold text-lg leading-tight">50+</span>
        <span class="text-xs text-darkslate-300">Vulnerabilities Found</span>
      </div>
    </div>
    
    <div class="flex items-center gap-2 text-primary-500">
      <div class="text-2xl">🏆</div>
      <div class="flex flex-col">
        <span class="font-bold text-lg leading-tight">OSCP & CEH</span>
        <span class="text-xs text-darkslate-300">Certifications</span>
      </div>
    </div>
    
    <div class="flex items-center gap-2 text-primary-500">
      <div class="text-2xl">🛡️</div>
      <div class="flex flex-col">
        <span class="font-bold text-lg leading-tight">Zebrabyte</span>
        <span class="text-xs text-darkslate-300">Agency Founder</span>
      </div>
    </div>
  </div>
</Card>
