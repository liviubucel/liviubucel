---
interface Props {
  isEmployed?: boolean;
}
const { isEmployed = false } = Astro.props;
---

<span class="relative flex h-3 w-3">
  <span
    class={`animate-ping absolute inline-flex h-full w-full rounded-full opacity-75 ${isEmployed ? 'bg-red-400' : 'bg-green-400'}`}
  ></span>
  <span class={`relative inline-flex rounded-full h-3 w-3 ${isEmployed ? 'bg-red-500' : 'bg-green-500'}`}></span>
</span>
