---
import { formatDate } from "../../lib/helpers";
import type { Language } from "../../lib/i18n";

interface Props {
  title: string;
  date: Date;
  id: string;
  lang?: Language;
  href?: string;
  badge?: string;
  excerpt?: string;
}

const { title, date, id, lang = 'en', href: hrefOverride, badge, excerpt } = Astro.props;
const href = hrefOverride ?? (lang === 'en' ? `/blog/${id}` : `/ro/blog/${id}`);
---

<li class="list-none w-full mb-3">
  <a
    class="block w-full bg-darkslate-600/40 hover:bg-darkslate-600/70 backdrop-blur-sm border border-darkslate-400/60 hover:border-darkslate-300 rounded-xl p-4 md:p-5 shadow-sm transition-all duration-200 ease-in-out"
    href={href}
  >
    {badge && (
      <div class="flex flex-wrap items-center gap-2 mb-2">
        <span class="text-xs uppercase tracking-wide font-semibold text-darkslate-900 bg-primary-400 px-2 py-0.5 rounded">
          {badge}
        </span>
      </div>
    )}
    <h2 class="text-lg md:text-xl font-semibold text-neutral-100 hover:text-neutral-50 transition-colors">
      {title}
    </h2>
    {excerpt && <p class="text-sm text-darkslate-200 mt-2 line-clamp-2">{excerpt}</p>}
    <time
      class="block text-sm text-darkslate-300 mt-3"
      data-date={date.toISOString()}
      datetime={date.toISOString()}
    >
      {formatDate(date)}
    </time>
  </a>
</li>
