---
import type { Language } from '../lib/i18n';
import Layout from '../layouts/Layout.astro';
import Seo from '../components/Seo.astro';
import { SITE } from '../site-config';
import { getPageSeo } from '../lib/sanity-queries';

export const prerender = false;

const lang: Language = 'en';
const seo = await getPageSeo('privacy');
const seoTitle = seo?.title || `Privacy Policy — ${SITE.author.fullName}`;
const seoDescription = seo?.description || 'How this site collects, uses, minimises, and protects personal data.';
const lastUpdated = 'August 2026';
---

<Layout description={seoDescription} title={seoTitle} lang={lang}>
  <Seo
    title={seoTitle}
    description={seoDescription}
    lang={lang}
    keywords={seo?.keywords}
    ogImage={seo?.ogImage}
    canonical={`${SITE.site.url}privacy`}
  />

  <main class="min-h-screen text-white px-4 py-16 md:py-24 max-w-3xl mx-auto">
    <a class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg inline-block" href="/">← Back</a>

    <h1 class="text-3xl md:text-4xl font-bold text-neutral-100 mb-2">Privacy Policy</h1>
    <p class="text-sm text-neutral-500 mb-10">Last updated: {lastUpdated}</p>

    <div class="space-y-8 text-neutral-300 leading-relaxed text-sm md:text-base">
      <section>
        <h2 class="text-lg font-semibold text-neutral-100 mb-2">1. Controller and scope</h2>
        <p>
          This site (liviubucel.com) is operated by {SITE.author.fullName}. This notice explains the personal data
          processed when you use optional site features and the limited technical data processed to operate and
          secure the site. It applies across this domain, including Romania Cyber Monitor.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-neutral-100 mb-2">2. Data processed</h2>
        <ul class="list-disc list-inside space-y-3">
          <li><strong class="text-neutral-100">Contact form:</strong> name, email address and the message you choose to send, so the enquiry can be read and answered.</li>
          <li><strong class="text-neutral-100">Newsletter:</strong> email address and subscription status. Double opt-in is used before newsletter delivery, and every newsletter includes an unsubscribe mechanism.</li>
          <li><strong class="text-neutral-100">CV request:</strong> name and email address only. The service no longer asks for a phone number or company name. The email is used to deliver the requested link and is not stored alongside the CV download token.</li>
          <li><strong class="text-neutral-100">Security and diagnostics:</strong> infrastructure providers may process technical request data such as IP address, browser/device information and request metadata. For CV abuse prevention, the application stores only a one-way hash derived from the client IP for a short rate-limit window, not the raw IP address.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-neutral-100 mb-2">3. Why the data is used</h2>
        <p class="mb-3">
          Data is used only for the feature you request, for operating and securing the site, and for diagnosing
          faults. The intended lawful basis for newsletter delivery is consent. Responding to direct enquiries,
          delivering a requested CV and preventing abuse are handled on the basis of the legitimate interests in
          providing and securing those requested site functions, subject to the applicable balancing requirements.
        </p>
        <p>
          Personal data is not sold, rented, used for behavioural advertising, or added to unrelated marketing lists.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-neutral-100 mb-2">4. CV download security and retention</h2>
        <ul class="list-disc list-inside space-y-2">
          <li>CV download tokens are generated using cryptographically secure randomness.</li>
          <li>The raw token is sent to the requester; the application stores only its SHA-256 hash.</li>
          <li>Each token is single-use and expires after 24 hours.</li>
          <li>Rate limiting uses a one-way IP-derived hash and a 24-hour request window.</li>
          <li>Expired rate-limit and token records are automatically pruned by the application during subsequent requests.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-neutral-100 mb-2">5. Other retention</h2>
        <ul class="list-disc list-inside space-y-2">
          <li>Contact messages are retained only as long as reasonably needed to handle and follow up the enquiry.</li>
          <li>Newsletter subscriber data is retained until unsubscribe, removal on request, or another valid operational reason requires deletion.</li>
          <li>Operational/security logs are retained according to the configured retention of the infrastructure and error-monitoring services.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-neutral-100 mb-2">6. Processors and infrastructure</h2>
        <p>
          The site uses Cloudflare infrastructure for hosting, Workers, database and email-related processing.
          Sentry is used for error monitoring and may process technical diagnostics needed to investigate faults.
          These providers act only as needed to provide the relevant technical services; there is no third-party
          advertising network or marketing tracker intentionally embedded by this site.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-neutral-100 mb-2">7. Romania Cyber Monitor</h2>
        <p class="mb-3">
          Romania Cyber Monitor publishes automated summaries derived from public threat-intelligence sources.
          Ransomware listings are treated as unconfirmed claims unless the source material supports stronger wording.
          Publication here is not independent proof that a named organisation was compromised.
        </p>
        <p>
          If an entry concerning your organisation appears inaccurate, use the <a href="/contact" class="text-primary-400 hover:underline">contact page</a> to request review or correction.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-neutral-100 mb-2">8. Your data-protection rights</h2>
        <p class="mb-3">
          Depending on where you are and which law applies, you may have rights including access, correction,
          deletion, restriction, objection, portability and withdrawal of consent where consent is the lawful basis.
        </p>
        <p>
          To make a privacy request, email <a href={`mailto:${SITE.links.email}`} class="text-primary-400 hover:underline">{SITE.links.email}</a>.
          UK residents may also raise concerns with the Information Commissioner's Office; people elsewhere can
          contact their applicable supervisory authority.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-neutral-100 mb-2">9. Changes</h2>
        <p>Material changes to this notice will be reflected by updating the date shown above.</p>
      </section>
    </div>
  </main>
</Layout>
