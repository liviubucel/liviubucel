---
import Card from "./Card/index.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../site-config";
import { getProfileSettings, getCertifications } from "../lib/sanity-queries";

interface Props {
  lang?: "en" | "ro";
}

const { lang = "en" } = Astro.props;
const isRO = lang === "ro";
const profile = await getProfileSettings();

const certs = (await getCertifications()).filter(
  (cert) => cert.status === "earned" && Boolean(cert.credentialUrl),
);

---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4">
  <div class="h-full flex flex-col">
    <header class="flex items-center">
      <h2 class="text-white text-xl font-bold">
        {isRO ? "Hai să lucrăm împreună!" : "Let's work together!"}
      </h2>
    </header>
    <div class="flex flex-col mt-4 gap-1">
      <h2 class="text-darkslate-300 text-xs uppercase tracking-wide">{isRO ? "Date de contact" : "Contact details"}</h2>
      <a
        href={`mailto:${SITE.links.email}`}
        class="text-sm hover:text-primary-400 transition-colors duration-150"
      >
        {SITE.links.email}
      </a>
      {profile?.phone && (
        <a
          href={`tel:${profile.phone.replace(/\s+/g, '')}`}
          class="text-sm hover:text-primary-400 transition-colors duration-150"
        >
          {profile.phone}
        </a>
      )}
      <p class="text-sm text-darkslate-300 mt-2">{SITE.location.countryName}</p>
    </div>

    {certs.length > 0 && (
    <div class="flex flex-col gap-2 mt-5 pt-4 border-t border-darkslate-700">
      <h2 class="text-white text-base font-bold">{isRO ? "Certificări verificate" : "Verified certifications"}</h2>
      <div class="flex flex-wrap items-start gap-x-6 gap-y-5">
        {certs.map((cert) => {
          const Tag = cert.credentialUrl ? 'a' : 'div';
          return (
            <Tag
              data-cert-badge
              class="flex items-center justify-center text-neutral-200 hover:text-white hover:-translate-y-1 hover:scale-110 transition-all duration-300 ease-out shrink-0"
              title={cert.name}
              {...(cert.credentialUrl ? { href: cert.credentialUrl, target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {cert.iconType === 'owasp' && <Icon name="simple-icons:owasp" class="h-10 w-10" />}
              {cert.iconType === 'comptia' && <Icon name="simple-icons:comptia" class="h-16 w-16" />}
              {cert.iconType === 'cisco' && <Icon name="simple-icons:cisco" class="h-12 w-12" />}
              {cert.iconType === 'isc2' && <Icon name="simple-icons:isc2" class="h-12 w-12" />}
              {cert.iconType === 'fortinet' && <Icon name="simple-icons:fortinet" class="h-12 w-12" />}
              {cert.iconType === 'paloaltonetworks' && <Icon name="simple-icons:paloaltonetworks" class="h-12 w-12" />}
              {cert.iconType === 'microsoft' && <Icon name="simple-icons:microsoft" class="h-12 w-12" />}
              {cert.iconType === 'googlecloud' && <Icon name="simple-icons:googlecloud" class="h-12 w-12" />}
              {cert.iconType === 'ibm' && <Icon name="simple-icons:ibm" class="h-12 w-12" />}
              {cert.iconType === 'redhat' && <Icon name="simple-icons:redhat" class="h-12 w-12" />}
              {cert.iconType === 'vmware' && <Icon name="simple-icons:vmware" class="h-12 w-12" />}
              {cert.iconType === 'junipernetworks' && <Icon name="simple-icons:junipernetworks" class="h-12 w-12" />}
              {cert.iconType === 'splunk' && <Icon name="simple-icons:splunk" class="h-12 w-12" />}
              {cert.iconType === 'sonicwall' && <Icon name="simple-icons:sonicwall" class="h-12 w-12" />}
              {cert.iconType === 'kalilinux' && <Icon name="simple-icons:kalilinux" class="h-12 w-12" />}
              {cert.iconType === 'linuxprofessionalinstitute' && <Icon name="simple-icons:linuxprofessionalinstitute" class="h-12 w-12" />}
              {cert.iconType === 'hackthebox' && <Icon name="simple-icons:hackthebox" class="h-12 w-12" />}
              {cert.iconType === 'tryhackme' && <Icon name="simple-icons:tryhackme" class="h-12 w-12" />}
              {cert.iconType === 'hackerone' && <Icon name="simple-icons:hackerone" class="h-12 w-12" />}
              {cert.iconType === 'shield' && <Icon name="ri:shield-check-line" class="h-12 w-12" />}
              {cert.iconType === 'network' && <Icon name="ri:router-line" class="h-12 w-12" />}
              {cert.iconType === 'bug' && <Icon name="ri:bug-line" class="h-12 w-12" />}
              {cert.iconType === 'terminal' && <Icon name="ri:terminal-box-line" class="h-12 w-12" />}
              {cert.iconType === 'lock' && <Icon name="ri:lock-2-line" class="h-12 w-12" />}
              {cert.iconType === 'award' && <Icon name="ri:award-line" class="h-12 w-12" />}
              {![
                'owasp','comptia','cisco','isc2','fortinet','paloaltonetworks','microsoft','googlecloud','ibm',
                'redhat','vmware','junipernetworks','splunk','sonicwall','kalilinux','linuxprofessionalinstitute',
                'hackthebox','tryhackme','hackerone','shield','network','bug','terminal','lock','award',
              ].includes(cert.iconType) && <Icon name="ri:award-line" class="h-12 w-12" />}
            </Tag>
          );
        })}
      </div>
    </div>    )}
  </div>
</Card>

<script>
  import { animate, stagger } from "motion";

  const badges = document.querySelectorAll("[data-cert-badge]");
  if (badges.length) {
    animate(
      badges,
      { opacity: [0, 1], y: [12, 0], scale: [0.85, 1] },
      { delay: stagger(0.08, { startDelay: 0.4 }), duration: 0.5, ease: "easeOut" },
    );
  }
</script>
