---
interface Props {
  rounded?: boolean;
  class?: string;
}

const { rounded, ...props } = Astro.props;
---

<button
  {...props}
  class={`h-full w-fit text-xl max-h-[50px] active:shadow-none active:translate-x-[3px] active:translate-y-[3px] text-darkslate-50 px-5 py-2 border border-darkslate-400 hover:border-darkslate-300 hover:text-darkslate-100 transition-colors duration-100 ease-in-out bg-darkslate-900 cursor-pointer ${
    rounded ? "rounded-full" : "rounded-lg"
  } ${props.class ?? ""}`}
>
  <slot />
</button>
