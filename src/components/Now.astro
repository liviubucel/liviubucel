---
import Card from "./Card/index.astro";
import Pulse from "./Pulse.astro";
import { Icon } from "astro-icon/components";
import { getProfileSettings, type ProfileSettings } from "../lib/sanity-queries";

interface Props {
  lang?: "en" | "ro";
  /** Pass this down from the page when it's already been fetched there
   * (e.g. alongside IntroCard/ContactsCard's own need for it) to avoid
   * firing the same Sanity query multiple times per page render. Falls
   * back to fetching it itself so the component still works standalone. */
  profile?: ProfileSettings | null;
}

const { lang = "en", profile: profileProp } = Astro.props;

let profile: ProfileSettings | null = null;
if (profileProp !== undefined) {
  profile = profileProp;
} else {
  try {
    profile = await getProfileSettings();
  } catch {}
}

const isEmployed = profile?.isCurrentlyEmployed ?? false;
const cvUrl = profile?.cvUrl ?? null;
const experienceHref = lang === "ro" ? "/ro/experience" : "/experience";
const isRO = lang === "ro";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-1" padding="p-4">
  <a href={experienceHref} class="block">
    <div class="flex justify-between w-full items-start mb-2">
      <h2 class="text-white text-xl font-bold">{isRO ? "Experiență" : "Experience"}</h2>
      <Pulse isEmployed={isEmployed} />
    </div>
    <p class="text-xs text-darkslate-300 mb-2">
      {isRO
        ? (isEmployed ? 'Angajat în prezent' : 'Deschis la oportunități')
        : (isEmployed ? 'Currently employed' : 'Open to opportunities')}
    </p>
  </a>
  {cvUrl ? (
    <a
      href={experienceHref}
      class="text-xs flex items-center gap-1 text-primary-400 hover:text-primary-300 transition-colors duration-150 cursor-pointer"
    >
      <Icon name="ri:download-line" class="h-3 w-3" />
      {isRO ? "Descarcă CV-ul" : "Download CV"}
    </a>
  ) : (
    <span class="text-xs flex items-center gap-1 text-darkslate-500 cursor-default">
      <Icon name="ri:download-line" class="h-3 w-3" />
      {isRO ? "Descarcă CV-ul" : "Download CV"}
    </span>
  )}
</Card>
