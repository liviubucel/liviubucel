---
import type { Language } from '../../lib/i18n';
import Layout from '../../layouts/Layout.astro';
import GuestbookForm from '../../components/GuestbookForm.astro';
import GuestbookEntries from '../../components/GuestbookEntries.astro';
import { SITE } from '../../site-config';
import { getGuestbookEntries } from '../../lib/sanity-queries';

const lang: Language = 'ro';
let entries = [];
try {
  entries = await getGuestbookEntries(lang);
} catch (error) {
  console.error('Failed to fetch guestbook entries:', error);
}

const labels = {
  en: {
    title: 'Testimonials',
    description: 'Success stories from people I\'ve worked with or helped',
    entriesTitle: 'What people say',
  },
  ro: {
    title: 'Testimoniale',
    description: 'Povești de succes de la persoane cu care am lucrat sau pe care le-am ajutat',
    entriesTitle: 'Ce spun oamenii',
  },
};

const t = labels[lang];
---

<Layout
  description={t.description}
  title={`${SITE.author.fullName} - ${t.title}`}
  lang={lang}
>
  <main class="w-screen min-h-screen flex flex-col justify-center items-center max-w-4xl mx-auto px-4 py-8 md:p-8">
    <a
      class="absolute top-4 left-4 md:top-8 md:left-8 text-white bg-neutral-900 hover:bg-neutral-800 px-3 py-1 md:px-4 md:py-2 text-sm md:text-base border-1 border-solid border-neutral-600 rounded-lg"
      href={lang === ('en' as Language) ? '/' : '/ro'}
    >
      Back
    </a>

    <h1 class="text-3xl md:text-4xl font-bold mb-4 text-neutral-100 text-center mt-12 md:mt-0">
      {t.title}
    </h1>
    <p class="text-darkslate-300 text-center mb-8 md:mb-12 max-w-lg">
      {t.description}
    </p>

    <div class="w-full grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12">
      <div class="flex flex-col">
        <GuestbookForm lang={lang} />
      </div>

      <div class="flex flex-col">
        <h2 class="text-2xl font-bold mb-8 text-neutral-100">
          {t.entriesTitle}
        </h2>
        <GuestbookEntries entries={entries} lang={lang} />
      </div>
    </div>
  </main>
</Layout>
