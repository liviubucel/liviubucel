---
import { sanityClient } from "sanity:client";
import { PortableText } from "astro-portabletext";
import LayoutBlogPost from "../../layouts/LayoutBlogPost.astro";
import { SITE } from "../../site-config";

export const prerender = true;

export async function getStaticPaths() {
  let projects = [];
  try {
    projects = await sanityClient.fetch(`*[_type == "project"] { "id": slug.current }`);
  } catch (error) {
    console.error("Sanity error fetching paths:", error);
  }
  
  if (!projects || projects.length === 0) {
    return [{ params: { id: "placeholder" } }];
  }

  return projects.map(({ id }) => ({
    params: { id },
  }));
}

const { id } = Astro.params;

let entry = null;
try {
  entry = await sanityClient.fetch(`*[_type == "project" && slug.current == $id][0]`, { id });
} catch(e) {
  console.error(e);
}

if (!entry) {
  if (id === "placeholder") {
    entry = { title: "Placeholder", pubDate: new Date().toISOString(), description: "Placeholder", body: [] };
  } else {
    return Astro.redirect("/404");
  }
}
---

<LayoutBlogPost
  description={entry.description || ""}
  minutesRead="5 min read"
  pubDate={entry.pubDate ? new Date(entry.pubDate) : new Date()}
  title={`${entry.title} | ${SITE.author.fullName}`}
  url={`projects/${id}`}
>
  <div class="prose prose-invert prose-neutral mx-auto">
    <PortableText value={entry.body} />
  </div>
</LayoutBlogPost>

<style is:global>
  /* Base typography is handled by the prose classes. Add custom overrides here if needed. */
  .prose a {
    color: var(--primary-500, #facc15);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 0.2s ease;
  }
  .prose a:hover {
    color: var(--primary-400, #fde047);
  }
  .prose pre {
    background-color: var(--darkslate-800, #1e293b);
    border: 1px solid var(--darkslate-700, #334155);
  }
  .prose blockquote {
    border-left-color: var(--primary-500, #facc15);
  }
</style>
