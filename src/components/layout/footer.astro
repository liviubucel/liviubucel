---
import GithubIcon from '@/assets/svg/github-icon'
import LinkedinIcon from '@/assets/svg/linkedin-icon'
import MailIcon from '@/assets/svg/mail'

const year = new Date().getFullYear()
const socials = [
  { label: 'GitHub', href: 'https://github.com/liviubucel', icon: GithubIcon },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/liviubucel/', icon: LinkedinIcon },
  { label: 'Email', href: 'mailto:contact@liviubucel.com', icon: MailIcon }
]
---

<footer class='lg:px-10.5'>
  <div class='mx-auto max-w-[1180px] border-t px-4 py-10 sm:px-6 lg:border-x lg:px-10'>
    <div class='grid gap-8 sm:grid-cols-[1fr_auto] sm:items-end'>
      <div>
        <p class='text-muted-foreground text-xs font-semibold uppercase tracking-[0.16em]'>Liviu Bucel</p>
        <p class='mt-2 max-w-md text-lg font-medium'>Cybersecurity, DFIR, threat research and practical security engineering.</p>
        <p class='text-muted-foreground mt-3 text-sm'>Built with Astro and deployed at the edge.</p>
      </div>

      <div class='flex items-center gap-2'>
        {socials.map(({ label, href, icon: Icon }) => (
          <a
            href={href}
            target={href.startsWith('http') ? '_blank' : undefined}
            rel={href.startsWith('http') ? 'noopener noreferrer' : undefined}
            aria-label={label}
            class='bg-background ring-border text-muted-foreground hover:text-foreground flex size-10 items-center justify-center rounded-full ring-1 transition-colors'
          >
            <Icon className='size-4' />
          </a>
        ))}
      </div>
    </div>

    <div class='text-muted-foreground mt-8 flex flex-wrap items-center justify-between gap-3 border-t pt-5 text-xs'>
      <p>© {year} Liviu Bucel</p>
      <div class='flex items-center gap-4'>
        <a href='/privacy' class='hover:text-foreground transition-colors'>Privacy</a>
        <a href='/blog' class='hover:text-foreground transition-colors'>Writing</a>
        <a href='/romania-cyber-monitor' class='hover:text-foreground transition-colors'>Cyber Monitor</a>
      </div>
    </div>
  </div>
</footer>
