---
import Card from "./Card/index.astro";

interface Props {
  lang?: "en" | "ro";
}

const { lang = "en" } = Astro.props;
const isRO = lang === "ro";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-6" title={isRO ? "Despre mine" : "About me"}>
  <div class="flex flex-col gap-2 text-sm font-light">
    <p>
      {isRO
        ? "Mă concentrez pe ethical hacking, investigarea criminalității cibernetice și criminalistică digitală."
        : "I focus on ethical hacking, cybercrime investigation, and digital forensics."}
    </p>
    <p>
      {isRO
        ? "Folosesc Kali Linux, Wireshark și Burp Suite pentru a analiza vulnerabilități și a înțelege atacurile în medii controlate."
        : "I use Kali Linux, Wireshark, and Burp Suite to analyse vulnerabilities and understand attacks in controlled environments."}
    </p>
    <p>
      {isRO
        ? "Activitatea mea combină gândirea ofensivă, atenția criminalistică la detalii și raportarea tehnică clară."
        : "My work combines offensive thinking, forensic attention to detail, and clear technical reporting."}
    </p>
    <div class="mt-2 pt-3 border-t border-darkslate-700">
      <p class="font-bold">{isRO ? "Competențe principale" : "Top skills"}</p>
      <p class="text-darkslate-300 mt-1">
        Networking · Information Security · Ethical Hacking · Digital Forensics
      </p>
    </div>
  </div>
</Card>
