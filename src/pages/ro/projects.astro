---
import type { Language } from '../../lib/i18n';
import Seo from '../../components/Seo.astro';
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../site-config';

const lang: Language = 'ro';
---

<Layout
  description="Proiectele mele și portofoliu"
  title={`${SITE.author.fullName} - Proiecte`}
  lang={lang}
>
  <main class="w-screen min-h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8">
    <a
      class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg"
      href="/ro/">Înapoi</a
    >
    <h1 class="text-4xl font-bold mb-4 text-neutral-100">
      Proiecte
    </h1>
    <p class="text-neutral-400">
      Secțiunea de proiecte va fi disponibilă în curând.
    </p>
  </main>
</Layout>
