---
import Card from "./Card/index.astro";

interface Props {
  lang?: "en" | "ro";
}

const { lang = "en" } = Astro.props;
const isRO = lang === "ro";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  title={isRO ? "Susține activitatea mea" : "Support my work"}
  href="https://buymeacoffee.com/liviubucel"
/>
