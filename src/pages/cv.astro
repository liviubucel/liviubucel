---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site-config';

const lang = 'en';
---

<Layout
  description={`${SITE.author.fullName} — Curriculum Vitae. BSc Cyber Security student at De Montfort University.`}
  title={`${SITE.author.fullName} - CV`}
  lang={lang}
>
  <main class="w-screen min-h-screen flex flex-col justify-center items-center max-w-4xl mx-auto px-4 py-8 md:p-8">
    <a
      class="absolute top-4 left-4 md:top-8 md:left-8 text-white bg-neutral-900 hover:bg-neutral-800 px-3 py-1 md:px-4 md:py-2 text-sm md:text-base border-1 border-solid border-neutral-600 rounded-lg"
      href="/"
    >
      Back
    </a>

    <h1 class="text-3xl md:text-4xl font-bold mb-4 text-neutral-100 text-center mt-12 md:mt-0">
      Curriculum Vitae
    </h1>
    <p class="text-darkslate-300 text-center mb-8 max-w-lg">
      My professional CV is coming soon. In the meantime, connect with me on LinkedIn or reach out directly.
    </p>

    <div class="flex flex-col items-center gap-4">
      <a
        href={SITE.links.linkedin}
        target="_blank"
        class="text-white bg-neutral-900 hover:bg-neutral-800 px-6 py-3 border border-neutral-600 rounded-lg font-bold"
      >
        View LinkedIn Profile
      </a>
      <a
        href={`mailto:${SITE.links.email}`}
        class="text-darkslate-300 hover:text-white text-sm"
      >
        {SITE.links.email}
      </a>
    </div>
  </main>
</Layout>
