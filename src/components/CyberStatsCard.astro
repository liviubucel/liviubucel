---
import Card from "./Card/index.astro";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  title="Education"
  href="/blog"
>
  <div class="flex flex-col gap-3 mt-4">
    <div class="flex items-center gap-3">
      <div class="text-xl">🎓</div>
      <div class="flex flex-col">
        <span class="font-bold text-sm text-neutral-100">BSc Cyber Security</span>
        <span class="text-xs text-darkslate-300">De Montfort University</span>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <div class="text-xl">📅</div>
      <div class="flex flex-col">
        <span class="font-bold text-sm text-neutral-100">Year 2 · In Progress</span>
        <span class="text-xs text-darkslate-300">Leicester, United Kingdom</span>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <div class="text-xl">🛡️</div>
      <div class="flex flex-col">
        <span class="font-bold text-sm text-neutral-100">DFIR · SOC · NetSec</span>
        <span class="text-xs text-darkslate-300">Focus areas</span>
      </div>
    </div>
  </div>
</Card>
