---
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE, type Language } from '../../lib/i18n';
import { getSEOMeta, getPersonSchema, generateAlternateLinks } from '../../lib/seo';
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card/index.astro";
import IntroCard from "../../components/IntroCard.astro";
import ContactsCard from "../../components/ContactsCard.astro";
import DonateCard from "../../components/DonateCard.astro";
import TimeZone from "../../components/TimeZoneCard.astro";
import AboutMe from "../../components/AboutMe.astro";
import Now from "../../components/Now.astro";
import CyberStatsCard from "../../components/CyberStatsCard.astro";
import DesignWorksCard from "../../components/DesignWorksCard.astro";
import { SITE } from "../../site-config";

export const prerender = true;

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Language };

// SEO metadata
const seoMeta = getSEOMeta({
  title: `${SITE.author.fullName} - ${SITE.author.jobTitle}`,
  description: `I'm a developer based in ${SITE.location.countryName}, passionate about user experience and specializing in engaging animations and micro-interactions.`,
  lang,
  canonical: `${SITE.site.url}${lang === DEFAULT_LANGUAGE ? '' : lang}/`,
});

const personSchema = getPersonSchema(lang);
const alternateLinks = generateAlternateLinks(Astro.url.pathname, SITE.site.url);

const isRO = lang === 'ro';
---

<Layout
  description={seoMeta.description}
  title={seoMeta.title}
  lang={lang}
>
  <script is:inline define:vars={{ personSchema }}>
    const schema = document.createElement('script');
    schema.type = 'application/ld+json';
    schema.textContent = JSON.stringify(personSchema);
    document.head.appendChild(schema);
  </script>

  <!-- Alternate links for SEO -->
  {alternateLinks.map(link => (
    <link rel="alternate" hreflang={link.hreflang} href={link.href} />
  ))}

  <main
    class="text-white m-auto p-2 grid gap-2 max-w-6xl overflow-hidden relative w-full sm:p-4 sm:gap-2 md:grid-cols-2 md:gap-3 md:p-6 lg:h-screen lg:grid-rows-8 lg:grid-cols-4 lg:gap-4 lg:max-h-[800px]"
  >
    <IntroCard />
    <AboutMe />
    <ContactsCard />
    <TimeZone />
    <DesignWorksCard />
    <Now />
    <Card
      href={`${lang === DEFAULT_LANGUAGE ? '' : `/${lang}`}/playground`}
      colSpan="md:col-span-1"
      rowSpan="md:row-span-1"
      title={isRO ? "Expozitie" : "Playground"}
    />
    <Card
      href={`${lang === DEFAULT_LANGUAGE ? '' : `/${lang}`}/guestbook`}
      colSpan="md:col-span-1"
      rowSpan="md:row-span-1"
      title={isRO ? "Cartea de Oaspeti" : "Guestbook"}
    />
    <Card
      href={`${lang === DEFAULT_LANGUAGE ? '' : `/${lang}`}/blog`}
      colSpan="md:col-span-1"
      rowSpan="md:row-span-1"
      title={isRO ? "Blog" : "Blog"}
    />
    <CyberStatsCard />
    <DonateCard />

    <Card colSpan="md:col-span-1" rowSpan="md:row-span-1">
      <p class="text-xs">
        © 2025 · {isRO ? "Creat cu ♥️ folosind" : "Crafted with ♥️ using"} <a
          class="text-red-500"
          href="https://astro.build/"
          target="_blank">Astro</a
        > {isRO ? "de mine." : "by Me."}
      </p>
    </Card>
  </main>
</Layout>

<script>
  import { stagger, animate, type AnimationSequence } from "motion";
  import { loaderAnimation } from "../../lib/constants";
  const cards = document.querySelectorAll(".card");

  const sequence = [
    loaderAnimation,
    [
      cards,
      { y: ["40%", "0%"], opacity: [0, 1] },
      {
        type: "spring",
        at: "-0.1",
        delay: stagger(0.2),
      },
    ],
  ];

  animate(sequence as AnimationSequence);
</script>
