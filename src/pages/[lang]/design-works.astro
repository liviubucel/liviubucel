---
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE, type Language } from '../../lib/i18n';
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../site-config';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Language };
const isRO = lang === 'ro';
---

<Layout
  description={isRO ? "Portofoliu de lucrări de design" : "Portfolio of design works"}
  title={`${SITE.author.fullName} - ${isRO ? 'Lucrări de Design' : 'Design Works'}`}
  lang={lang}
>
  <main class="w-screen min-h-screen flex flex-col justify-center items-center max-w-4xl mx-auto p-8">
    <a
      class="absolute top-8 left-8 text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 border-1 border-solid border-neutral-600 rounded-lg"
      href={lang === DEFAULT_LANGUAGE ? '/' : `/${lang}/`}>Back</a
    >
    <h1 class="text-4xl font-bold mb-8 text-neutral-100">
      {isRO ? 'Lucrări de Design' : 'Design Works'}
    </h1>
    <p class="text-neutral-400 text-center">
      {isRO
        ? 'Secțiunea de lucrări de design va fi disponibilă în curând.'
        : 'Design works section coming soon.'}
    </p>
  </main>
</Layout>
