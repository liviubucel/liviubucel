---
import PortfolioLayout from '@/layouts/PortfolioLayout.astro'
import Hero from '@/components/home/hero/hero.astro'
import About from '@/components/home/about/about.astro'
import FeaturedWorks from '@/components/shared/featured-works/featured-works.astro'
import Experience from '@/components/home/experience/experience.astro'
import Services from '@/components/shared/services/services'
import Testimonials from '@/components/shared/testimonials/testimonials'
import HireMe from '@/components/home/hire-me/hire-me.astro'
import SelectService from '@/components/home/select-service/select-service.astro'
import type { CaseStudyMetadata } from '@/lib/case-studies'

export const prerender = false

const caseStudies: CaseStudyMetadata[] = [
  {
    slug: 'romania-cyber-monitor',
    href: '/romania-cyber-monitor',
    title: 'Romania Cyber Monitor',
    description: 'A public cyber threat monitoring project that collects, normalises and presents Romania-linked ransomware, breach, malware and exposure data.',
    organisation: 'Independent project',
    role: 'Threat research & engineering',
    duration: 'Ongoing',
    publishedAt: '2026-09-01',
    image: '/globe_preview.png',
    logo: '/illustrations/roman_shield.webp'
  },
  {
    slug: 'zebrabyte',
    href: '/projects',
    title: 'ZebraByte',
    description: 'Security-focused infrastructure and platform work spanning hosting, DNS, TLS, edge security and operational hardening.',
    organisation: 'ZebraByte',
    role: 'Infrastructure & security',
    duration: 'Ongoing',
    publishedAt: '2024-06-01',
    image: '/preview.png',
    logo: '/illustrations/shield_logo.webp'
  },
  {
    slug: 'ssl-certificate-generator',
    href: 'https://ssl-gratis.zebrabyte.ro/',
    title: 'SSL Certificate Generator',
    description: 'An ACME automation project for domain validation, certificate issuance and deployment-ready TLS/SSL certificate packages.',
    organisation: 'Independent project',
    role: 'ACME / PKI automation',
    duration: 'Security automation',
    publishedAt: '2024-01-01',
    image: '/illustrations/shield_logo.webp',
    logo: '/illustrations/roman_shield.webp'
  }
]

const pageTitle = 'Liviu Bucel — Cybersecurity Portfolio'
const pageDescription = 'Cybersecurity portfolio focused on ethical hacking, DFIR, digital investigation, incident response, threat research and practical security work.'
const pageKeywords = 'cybersecurity, ethical hacking, DFIR, digital forensics, incident response, threat research'

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Liviu Bucel',
      description: pageDescription,
      inLanguage: 'en-GB'
    }
  ]
}
---

<PortfolioLayout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={schema}>
  <Hero />
  <About />
  <FeaturedWorks caseStudies={caseStudies} />
  <Experience />
  <Services client:visible />
  <Testimonials client:visible />
  <HireMe />
  <SelectService />
</PortfolioLayout>
