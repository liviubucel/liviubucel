---
import Card from "./Card/index.astro";
import { SITE } from "../site-config";

interface Props {
  lang?: "en" | "ro";
}

const { lang = "en" } = Astro.props;
const isRO = lang === "ro";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-6" title={isRO ? "Despre mine" : "About me"}>
  <div class="flex flex-col gap-2">
    <p class="sr-only">
      {isRO ? (
        <>
          Salut, sunt {SITE.author.firstName}, specialist în securitate cibernetică din {SITE.location.countryName}.
          Ariile mele principale de expertiză includ Ethical Hacking, Investigații Digitale, Criptografie și Operațiuni de Securitate.
          Am o diplomă de la De Montfort University și sunt dedicat dezvoltării securității cibernetice prin experiență practică și învățare continuă.
        </>
      ) : (
        <>
          Hi, I'm {SITE.author.firstName}, a Cyber Security Specialist based in {SITE.location.countryName}.
          My primary areas of expertise include Ethical Hacking, Digital Forensics, Cryptography, and Security Operations.
          I hold a degree from De Montfort University and am committed to advancing cybersecurity through hands-on experience and continuous learning.
        </>
      )}
    </p>
    <div aria-hidden="true" class="text-sm font-light">
      {isRO ? (
        <>
          <p class="text-sm font-light">
            Salut, sunt {SITE.author.firstName}, specialist în securitate cibernetică din {SITE.location.countryName}.
          </p>
          <br />
          Ariile mele principale de expertiză:
          <ul class="list-disc list-inside">
            <li>Ethical Hacking</li>
            <li>Investigații Digitale</li>
            <li>Criptografie</li>
            <li>Testare de Penetrare</li>
            <li>Evaluări de Securitate</li>
            <li>Cercetarea Vulnerabilităților</li>
          </ul>
          <p class="text-sm font-light mt-2">
            Am o diplomă de la De Montfort University (DMU). Misiunea mea este să ajut organizațiile și persoanele să rămână în siguranță, combinând expertiza academică cu abilități practice de securitate.
          </p>
        </>
      ) : (
        <>
          <p class="text-sm font-light">
            Hi, I'm {SITE.author.firstName}, a Cyber Security Specialist based in {SITE.location.countryName}.
          </p>
          <br />
          My primary areas of expertise:
          <ul class="list-disc list-inside">
            <li>Ethical Hacking</li>
            <li>Digital Forensics</li>
            <li>Cryptography</li>
            <li>Penetration Testing</li>
            <li>Security Assessments</li>
            <li>Vulnerability Research</li>
          </ul>
          <p class="text-sm font-light mt-2">
            I hold a degree from De Montfort University (DMU). My mission is to help organizations and individuals stay secure by combining academic expertise with practical security skills.
          </p>
        </>
      )}
    </div>
  </div>
</Card>
