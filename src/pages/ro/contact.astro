---
import type { Language } from '../../lib/i18n';
import Layout from '../../layouts/Layout.astro';
import Seo from '../../components/Seo.astro';
import { SITE } from '../../site-config';
import { getPageSeo } from '../../lib/sanity-queries';

export const prerender = false;

const lang: Language = 'ro';

const topics = [
  'Cercetare de Securitate',
  'Colaborare',
  'Oportunitate de Carieră',
  'CTF / Provocare',
  'Întrebare Generală',
];

const seo = await getPageSeo("contact-ro");
const seoTitle = seo?.title || `Contact — ${SITE.author.fullName}`;
const seoDescription = seo?.description || "Contactează-l pe Liviu Bucel pentru securitate cibernetică, cercetare de securitate și colaborări tehnice relevante.";
---

<Layout
  description={seoDescription}
  title={seoTitle}
  lang={lang}
>
  <Seo
    title={seoTitle}
    description={seoDescription}
    lang={lang}
    keywords={seo?.keywords}
    ogImage={seo?.ogImage}
    canonical={`${SITE.site.url}ro/contact`}
  />

  <main class="min-h-screen text-white px-4 py-16 md:py-24 max-w-5xl mx-auto">
    <a
      class="absolute top-4 left-4 md:top-8 md:left-8 text-white bg-neutral-900 hover:bg-neutral-800 px-3 py-1 md:px-4 md:py-2 text-sm border border-neutral-600 rounded-lg transition-colors duration-150"
      href="/ro"
    >
      ← Înapoi
    </a>

    <div class="mt-12 md:mt-0 grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">

      <!-- Left column: info -->
      <div>
        <p class="text-xs font-medium text-neutral-500 uppercase tracking-widest mb-3">Ia legătura</p>
        <h1 class="text-3xl md:text-4xl font-bold leading-tight tracking-tight text-neutral-100 mb-4">
          Hai să vorbim
        </h1>
        <p class="text-neutral-400 text-base leading-relaxed mb-8">
          Ai o întrebare de securitate, vrei să colaborăm pe un proiect sau pur și simplu vrei să te conectezi — mă bucur să aud de tine.
        </p>

        <ul class="space-y-4 mb-8" aria-label="Detalii de contact">
          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-neutral-700 bg-neutral-800 text-primary-400" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect width="20" height="16" x="2" y="4" rx="2" />
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
              </svg>
            </span>
            <div>
              <p class="text-xs font-medium text-neutral-500 uppercase tracking-wide mb-0.5">Email</p>
              <a href={`mailto:${SITE.links.email}`} class="text-sm text-neutral-200 hover:text-primary-400 transition-colors duration-150">
                {SITE.links.email}
              </a>
            </div>
          </li>

          <li class="flex items-start gap-3">
            <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-neutral-700 bg-neutral-800 text-primary-400" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10" />
                <polyline points="12 6 12 12 16 14" />
              </svg>
            </span>
            <div>
              <p class="text-xs font-medium text-neutral-500 uppercase tracking-wide mb-0.5">Timp de răspuns</p>
              <p class="text-sm text-neutral-300">De obicei în 24 de ore</p>
            </div>
          </li>
        </ul>

        <div class="rounded-xl border border-neutral-700 bg-neutral-800/50 p-5">
          <p class="text-sm font-semibold text-neutral-100 mb-1">Securitate cibernetică?</p>
          <p class="text-sm text-neutral-400 leading-relaxed">
            Pentru cercetare de securitate, dezvăluire responsabilă de vulnerabilități sau întrebări tehnice — sunt disponibil.
          </p>
        </div>
      </div>

      <!-- Right column: form -->
      <div class="rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-8">
        <form id="contact-form" novalidate>
          <div class="space-y-4">
            <div class="grid gap-4 sm:grid-cols-2">
              <div class="space-y-1.5">
                <label for="contact-name" class="text-sm font-medium text-neutral-200">
                  Nume <span class="text-red-400" aria-hidden="true">*</span>
                </label>
                <input
                  id="contact-name"
                  type="text"
                  name="name"
                  required
                  autocomplete="name"
                  maxlength="100"
                  placeholder="Numele tău"
                  class="flex h-10 w-full rounded-xl border border-neutral-600 bg-neutral-900 px-3 py-2 text-sm text-neutral-100 placeholder:text-neutral-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900 transition-colors duration-150"
                />
              </div>

              <div class="space-y-1.5">
                <label for="contact-email" class="text-sm font-medium text-neutral-200">
                  Email <span class="text-red-400" aria-hidden="true">*</span>
                </label>
                <input
                  id="contact-email"
                  type="email"
                  name="email"
                  required
                  autocomplete="email"
                  maxlength="254"
                  placeholder="tu@exemplu.ro"
                  class="flex h-10 w-full rounded-xl border border-neutral-600 bg-neutral-900 px-3 py-2 text-sm text-neutral-100 placeholder:text-neutral-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900 transition-colors duration-150"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="contact-topic" class="text-sm font-medium text-neutral-200">
                Subiect
              </label>
              <select
                id="contact-topic"
                name="topic"
                class="flex h-10 w-full rounded-xl border border-neutral-600 bg-neutral-900 px-3 py-2 text-sm text-neutral-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900 transition-colors duration-150"
              >
                <option value="">Selectează (opțional)</option>
                {topics.map((t) => <option value={t}>{t}</option>)}
              </select>
            </div>

            <div class="space-y-1.5">
              <label for="contact-message" class="text-sm font-medium text-neutral-200">
                Mesaj <span class="text-red-400" aria-hidden="true">*</span>
              </label>
              <textarea
                id="contact-message"
                name="message"
                required
                rows="5"
                maxlength="5000"
                placeholder="Cu ce te pot ajuta?"
                class="flex w-full rounded-xl border border-neutral-600 bg-neutral-900 px-3 py-2 text-sm text-neutral-100 placeholder:text-neutral-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900 resize-y min-h-[120px] transition-colors duration-150"
              ></textarea>
            </div>

            <p class="text-xs text-neutral-500">
              <span class="text-red-400" aria-hidden="true">*</span> Câmpuri obligatorii
            </p>

            <button
              type="submit"
              class="inline-flex h-10 w-full items-center justify-center gap-1.5 whitespace-nowrap rounded-xl bg-primary-600 px-5 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:bg-primary-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900 disabled:pointer-events-none disabled:opacity-60 cursor-pointer"
            >
              <span data-submit-label>Trimite mesajul</span>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><path d="m9 6 6 6-6 6" /></svg>
            </button>

            <p
              id="contact-form-status"
              role="status"
              aria-live="polite"
              class="hidden rounded-xl border px-4 py-3 text-sm"
            ></p>
          </div>
        </form>
      </div>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-form-status');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const submitLabel = submitButton?.querySelector('[data-submit-label]') as HTMLElement | null;
    const originalLabel = submitLabel?.textContent ?? 'Trimite mesajul';

    if (submitButton && submitLabel) {
      submitButton.disabled = true;
      submitLabel.textContent = 'Se trimite…';
    }

    status.classList.add('hidden');
    status.classList.remove(
      'border-red-500/30', 'bg-red-500/10', 'text-red-400',
      'border-neutral-700', 'bg-neutral-800', 'text-neutral-200',
    );

    try {
      const response = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });

      let data: { success: boolean; error?: string };
      try {
        data = await response.json();
      } catch {
        throw new Error('Ceva a mers greșit. Te rog încearcă din nou sau trimite-mi un email direct.');
      }

      if (!data.success) throw new Error(data.error || 'Ceva a mers greșit. Te rog încearcă din nou.');

      form.reset();
      status.textContent = 'Mulțumesc! Mesajul a fost trimis — revin cât mai curând.';
      status.classList.add('border-neutral-700', 'bg-neutral-800', 'text-neutral-200');
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : 'Ceva a mers greșit. Te rog încearcă din nou.';
      status.classList.add('border-red-500/30', 'bg-red-500/10', 'text-red-400');
    } finally {
      status.classList.remove('hidden');
      if (submitButton && submitLabel) {
        submitButton.disabled = false;
        submitLabel.textContent = originalLabel;
      }
    }
  });
</script>
