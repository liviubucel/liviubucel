---
import { formatDate } from "../../lib/helpers";
import type { Language } from "../../lib/i18n";

interface Props {
  title: string;
  date: Date;
  id: string;
  lang?: Language;
}

const { title, date, id, lang = 'en' } = Astro.props;
const href = lang === 'en' ? `/blog/${id}` : `/ro/blog/${id}`;
---

<li
  class="list-none w-full text-neutral-100 hover:text-neutral-400 ease-in-out transition-colors border-b-neutral-400 border-dashed border-b-1 my-2"
>
  <a
    class="text-sm md:text-base decoration-none flex justify-between"
    href={href}
  >
    <p class="inline-block whitespace-nowrap">
      {title}
    </p>
    <time
      class="text-right tabular-nums"
      data-date={date.toISOString()}       datetime={date.toISOString()}
    >
      {formatDate(date)}
    </time>
  </a>
</li>
