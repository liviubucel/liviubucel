---
import Card from "./Card/index.astro";
import { SITE } from "../site-config";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-6" title="About me">
  <div class="flex flex-col gap-2">
    <p class="sr-only">
      Hi, I'm {SITE.author.firstName}, a Cyber Security Specialist based in the {SITE.location.countryName}.
      My professional focus includes Ethical Hacking, Digital Forensics, Cryptography, and SOC analysis.
      My work is grounded in hands-on projects, technical research, and security-focused tooling.
    </p>
    <div aria-hidden="true" class="text-sm font-light">
      <p class="text-sm font-light">
        Hi, I'm {SITE.author.firstName}, a Cyber Security Specialist based in the {SITE.location.countryName}.
      </p>
      <br />
      Core focus areas:
      <ul class="list-disc list-inside">
        <li>Ethical Hacking</li>
        <li>Digital Forensics</li>
        <li>Cryptography</li>
        <li>SOC Analysis</li>
        <li>Penetration Testing</li>
        <li>Incident Response</li>
      </ul>
      <p class="text-sm font-light mt-2">
        Applying practical skills through security projects, technical research, and continuous improvement.
      </p>
    </div>
  </div>
</Card>
