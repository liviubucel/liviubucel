---
import Card from "./Card/index.astro";
import { Icon } from "astro-icon/components";
import { SITE } from "../site-config";
import { getProfileSettings, getCertifications } from "../lib/sanity-queries";

const profile = await getProfileSettings();

let certs = await getCertifications();

if (!certs.length) {
  certs = [
    { _id: '1', name: 'OWASP Member', issuer: 'OWASP', status: 'earned', iconType: 'owasp' },
    { _id: '2', name: 'CompTIA Security+', issuer: 'CompTIA', status: 'in-progress', iconType: 'comptia' },
    { _id: '3', name: 'CCNA', issuer: 'Cisco', status: 'planned', iconType: 'cisco' },
  ] as any;
}

---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4">
  <div class="h-full flex flex-col">
    <header class="flex items-center">
      <h2 class="text-white text-xl font-bold">
        Let's start working together!
      </h2>
    </header>
    <div class="flex flex-col mt-4 gap-1">
      <h2 class="text-darkslate-300 text-xs uppercase tracking-wide">Contact Details</h2>
      <a
        href={`mailto:${SITE.links.email}`}
        class="text-sm hover:text-primary-400 transition-colors duration-150"
      >
        {SITE.links.email}
      </a>
      {profile?.phone && (
        <a
          href={`tel:${profile.phone.replace(/\s+/g, '')}`}
          class="text-sm hover:text-primary-400 transition-colors duration-150"
        >
          {profile.phone}
        </a>
      )}
      <p class="text-sm text-darkslate-300 mt-2">{SITE.location.countryName}</p>
    </div>

    <div class="flex flex-col gap-2 mt-5 pt-4 border-t border-darkslate-700">
      <h2 class="text-white text-base font-bold">Certifications</h2>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
        {certs.map((cert) => {
          const Tag = cert.credentialUrl ? 'a' : 'div';
          return (
            <Tag
              class="flex items-center justify-center text-neutral-300 hover:text-white transition-colors duration-150 shrink-0"
              title={cert.name}
              {...(cert.credentialUrl ? { href: cert.credentialUrl, target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {cert.iconType === 'owasp' && <Icon name="simple-icons:owasp" class="h-9 w-9" />}
              {cert.iconType === 'comptia' && <Icon name="simple-icons:comptia" class="h-9 w-9" />}
              {cert.iconType === 'cisco' && <Icon name="simple-icons:cisco" class="h-9 w-9" />}
              {cert.iconType === 'shield' && <Icon name="ri:shield-check-line" class="h-8 w-8" />}
              {cert.iconType === 'network' && <Icon name="ri:router-line" class="h-8 w-8" />}
              {cert.iconType === 'bug' && <Icon name="ri:bug-line" class="h-8 w-8" />}
              {cert.iconType === 'terminal' && <Icon name="ri:terminal-box-line" class="h-8 w-8" />}
              {cert.iconType === 'lock' && <Icon name="ri:lock-2-line" class="h-8 w-8" />}
              {cert.iconType === 'award' && <Icon name="ri:award-line" class="h-8 w-8" />}
              {!['owasp','comptia','cisco','shield','network','bug','terminal','lock','award'].includes(cert.iconType) && <Icon name="ri:award-line" class="h-8 w-8" />}
            </Tag>
          );
        })}
      </div>
    </div>
  </div>
</Card>
