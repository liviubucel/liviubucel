---
import Eyebrow from '@/components/shared/eyebrow/eyebrow.astro'
import ActivityCard from '@/components/home/experience/activity-card'
import ExperienceTimeline from '@/components/home/experience/experience.tsx'
---

<section id='experience' class='min-w-0 border-b py-10 sm:py-16 lg:py-24'>
  <div class='mx-auto max-w-7xl space-y-8 px-4 sm:px-6 lg:space-y-12 lg:px-10.5'>
    <div class='max-w-2xl space-y-3'>
      <Eyebrow text='Experience & toolkit' />
      <h2 class='text-2xl font-semibold tracking-tight md:text-3xl lg:text-4xl'>From infrastructure support to practical security work</h2>
      <p class='text-muted-foreground text-base leading-relaxed sm:text-lg'>A technical path built around troubleshooting real systems, understanding how they fail and then moving deeper into security testing and investigation.</p>
    </div>
    <ActivityCard />
    <ExperienceTimeline />
  </div>
</section>
