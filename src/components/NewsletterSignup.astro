---
import type { Language } from '../lib/i18n';
import Card from './Card/index.astro';

interface Props {
  /** From ?newsletter=confirmed|unsubscribed|invalid on the current URL. */
  initialStatus?: string | null;
  lang?: Language;
}

const { initialStatus = null, lang = 'en' } = Astro.props;

const COPY = {
  en: {
    heading: 'Romania Cyber Monitor updates',
    description:
      'Get an email whenever a new, Romania-linked ransomware claim or breach is published. No spam, one email per batch of updates, unsubscribe anytime.',
    emailLabel: 'Email address',
    placeholder: 'you@example.com',
    subscribe: 'Subscribe',
    subscribing: 'Subscribing…',
    consentPrefix: 'I agree to the',
    consentLinkText: 'Privacy Policy',
    consentSuffix: 'and to receiving these emails.',
    consentRequired: 'Please agree to the privacy policy to subscribe.',
    confirmed: "You're subscribed! You'll get an email whenever a new Romania-linked incident is published.",
    unsubscribed: "You've been unsubscribed. You won't receive any more emails.",
    invalid: 'That link is invalid or has expired.',
    alreadySubscribed: "You're already subscribed.",
    pending: 'Almost there — check your inbox for a confirmation email.',
    genericError: 'Something went wrong. Please try again.',
    privacyHref: '/privacy',
  },
  ro: {
    heading: 'Actualizări Romania Cyber Monitor',
    description:
      'Primești un e-mail de fiecare dată când apare o revendicare de ransomware sau o breșă legată de România. Fără spam, un singur e-mail per lot de actualizări, te poți dezabona oricând.',
    emailLabel: 'Adresă de e-mail',
    placeholder: 'nume@exemplu.ro',
    subscribe: 'Abonează-te',
    subscribing: 'Se procesează…',
    consentPrefix: 'Sunt de acord cu',
    consentLinkText: 'Politica de confidențialitate',
    consentSuffix: 'și consimt să primesc aceste e-mailuri.',
    consentRequired: 'Trebuie să fii de acord cu politica de confidențialitate pentru a te abona.',
    confirmed: 'Te-ai abonat! Vei primi un e-mail de fiecare dată când apare un nou incident legat de România.',
    unsubscribed: 'Te-ai dezabonat. Nu vei mai primi e-mailuri.',
    invalid: 'Acest link este invalid sau a expirat.',
    alreadySubscribed: 'Ești deja abonat.',
    pending: 'Aproape gata — verifică-ți inboxul pentru e-mailul de confirmare.',
    genericError: 'Ceva nu a funcționat. Te rugăm să încerci din nou.',
    privacyHref: '/ro/privacy',
  },
} as const;

const t = COPY[lang];

const initialMessage =
  initialStatus === 'confirmed'
    ? t.confirmed
    : initialStatus === 'unsubscribed'
      ? t.unsubscribed
      : initialStatus === 'invalid'
        ? t.invalid
        : null;

const initialIsError = initialStatus === 'invalid';
---

<section class="w-full max-w-6xl mx-auto px-2 sm:px-4 md:px-6 mt-3 md:mt-4">
  <Card colSpan="" rowSpan="" padding="p-6 md:p-8" height="h-auto">
    <h2 class="text-lg md:text-xl font-bold text-neutral-100">{t.heading}</h2>
    <p class="text-sm text-darkslate-200 mt-1 max-w-xl">
      {t.description}
    </p>

    <form
      id="newsletter-form"
      novalidate
      class="mt-4 max-w-md"
      data-i18n={JSON.stringify({
        subscribe: t.subscribe,
        subscribing: t.subscribing,
        alreadySubscribed: t.alreadySubscribed,
        pending: t.pending,
        genericError: t.genericError,
        consentRequired: t.consentRequired,
      })}
    >
      <div class="flex flex-col sm:flex-row sm:items-center gap-3">
        <label for="newsletter-email" class="sr-only">{t.emailLabel}</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          required
          autocomplete="email"
          maxlength="254"
          placeholder={t.placeholder}
          class="flex-1 h-10 rounded-lg border-2 border-darkslate-300 bg-darkslate-800 px-3.5 text-sm text-neutral-100 placeholder:text-darkslate-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
        />
        <button
          type="submit"
          class="w-fit self-start h-9 sm:h-10 px-4 sm:px-5 rounded-lg bg-primary-600 hover:bg-primary-500 text-xs sm:text-sm font-semibold text-darkslate-900 transition-colors duration-150 disabled:opacity-60 disabled:pointer-events-none cursor-pointer"
        >
          <span data-submit-label>{t.subscribe}</span>
        </button>
      </div>

      <div class="mt-3 flex items-start gap-2">
        <input
          id="newsletter-consent"
          type="checkbox"
          name="consent"
          required
          class="mt-0.5 h-4 w-4 shrink-0 rounded border-darkslate-300 bg-darkslate-800 text-primary-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 cursor-pointer"
        />
        <label for="newsletter-consent" class="text-xs text-darkslate-300 leading-snug">
          {t.consentPrefix} <a href={t.privacyHref} class="text-primary-400 hover:underline">{t.consentLinkText}</a> {t.consentSuffix}
        </label>
      </div>
    </form>

    <p
      id="newsletter-form-status"
      role="status"
      aria-live="polite"
      class:list={[
        'mt-3 rounded-lg border px-4 py-2.5 text-sm max-w-md',
        initialMessage ? 'block' : 'hidden',
        initialIsError
          ? 'border-red-500/30 bg-red-500/10 text-red-400'
          : 'border-darkslate-400 bg-darkslate-700 text-neutral-200',
      ]}
    >
      {initialMessage}
    </p>
  </Card>
</section>

<script>
  const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
  const status = document.getElementById('newsletter-form-status');

  interface I18n {
    subscribe: string;
    subscribing: string;
    alreadySubscribed: string;
    pending: string;
    genericError: string;
    consentRequired: string;
  }
  const i18n: I18n = form ? JSON.parse(form.dataset.i18n ?? '{}') : ({} as I18n);

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status) return;

    const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const submitLabel = submitButton?.querySelector('[data-submit-label]') as HTMLElement | null;
    const originalLabel = submitLabel?.textContent ?? i18n.subscribe;
    const consentInput = form.querySelector('#newsletter-consent') as HTMLInputElement | null;

    status.classList.remove('hidden');
    status.classList.add('block');
    status.classList.remove(
      'border-red-500/30', 'bg-red-500/10', 'text-red-400',
      'border-darkslate-400', 'bg-darkslate-700', 'text-neutral-200',
    );

    if (consentInput && !consentInput.checked) {
      status.textContent = i18n.consentRequired;
      status.classList.add('border-red-500/30', 'bg-red-500/10', 'text-red-400');
      return;
    }

    if (submitButton && submitLabel) {
      submitButton.disabled = true;
      submitLabel.textContent = i18n.subscribing;
    }

    try {
      const response = await fetch('/api/newsletter/subscribe', { method: 'POST', body: new FormData(form) });

      let data: { success: boolean; error?: string; alreadySubscribed?: boolean };
      try {
        data = await response.json();
      } catch {
        throw new Error(i18n.genericError);
      }

      if (!data.success) throw new Error(data.error || i18n.genericError);

      form.reset();
      status.textContent = data.alreadySubscribed ? i18n.alreadySubscribed : i18n.pending;
      status.classList.add('border-darkslate-400', 'bg-darkslate-700', 'text-neutral-200');
    } catch (error) {
      status.textContent = error instanceof Error ? error.message : i18n.genericError;
      status.classList.add('border-red-500/30', 'bg-red-500/10', 'text-red-400');
    } finally {
      if (submitButton && submitLabel) {
        submitButton.disabled = false;
        submitLabel.textContent = originalLabel;
      }
    }
  });
</script>
