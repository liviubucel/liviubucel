---
import PortfolioLayout from '@/layouts/PortfolioLayout.astro'
import Hero from '@/components/home/hero/hero.astro'
import About from '@/components/home/about/about.astro'
import SelectedWork from '@/components/home/selected-work/selected-work.astro'
import Experience from '@/components/home/experience/experience.astro'
import SecurityFocus from '@/components/shared/services/services'
import Research from '@/components/home/research/research.astro'
import { SITE } from '@/site-config'
import { getPageSeo } from '@/lib/sanity-queries'

export const prerender = false

const seo = await getPageSeo('home')
const pageTitle = seo?.title || 'Liviu Bucel — Cybersecurity, Ethical Hacking & Digital Investigation'
const pageDescription = seo?.description || 'Cybersecurity portfolio focused on ethical hacking, digital investigation, incident response, security testing, threat research, and practical security projects.'
const pageKeywords = (seo?.keywords || ['cybersecurity', 'ethical hacking', 'digital forensics', 'DFIR', 'incident response', 'penetration testing', 'threat research']).join(', ')
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author.fullName,
  url: SITE.site.url,
  jobTitle: SITE.author.jobTitle,
  sameAs: [SITE.links.github, SITE.links.linkedin],
  knowsAbout: ['Cybersecurity', 'Digital Forensics', 'Incident Response', 'Ethical Hacking', 'Penetration Testing', 'Threat Research']
}
---

<PortfolioLayout title={pageTitle} description={pageDescription} keywords={pageKeywords} schema={schema}>
  <Hero />
  <About />
  <SelectedWork />
  <Experience />
  <SecurityFocus client:visible />
  <Research />

  <section class='py-8 sm:py-16 lg:py-24'>
    <div class='px-4 sm:px-6 lg:px-10.5'>
      <div class='rounded-3xl border bg-card p-6 text-center shadow-sm sm:p-10'>
        <p class='text-accent text-xs font-semibold uppercase tracking-widest'>Contact</p>
        <h2 class='mx-auto mt-3 max-w-2xl text-2xl font-semibold md:text-3xl lg:text-4xl'>Have a security problem worth investigating?</h2>
        <p class='text-muted-foreground mx-auto mt-3 max-w-xl'>For professional opportunities, technical collaboration, research, or a security conversation, get in touch.</p>
        <div class='mt-6 flex flex-wrap justify-center gap-3'>
          <a href='/contact' class='bg-primary text-primary-foreground rounded-full px-5 py-2.5 text-sm font-semibold'>Contact me</a>
          <a href='/experience#cv' class='rounded-full border bg-background px-5 py-2.5 text-sm font-semibold'>Request CV</a>
        </div>
      </div>
    </div>
  </section>
</PortfolioLayout>
