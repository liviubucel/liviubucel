---
import { SUPPORTED_LANGUAGES, DEFAULT_LANGUAGE, type Language } from '../../lib/i18n';
import Layout from '../../layouts/Layout.astro';
import { SITE } from '../../site-config';

export function getStaticPaths() {
  return SUPPORTED_LANGUAGES.map(lang => ({
    params: { lang }
  }));
}

const { lang } = Astro.params as { lang: Language };
const isRO = lang === 'ro';
---

<Layout
  description={isRO ? "Cartea de oaspeți - lasă-ți un mesaj!" : "Guestbook - leave a message!"}
  title={`${SITE.author.fullName} - ${isRO ? 'Cartea de Oaspeți' : 'Guestbook'}`}
  lang={lang}
>
  <main class="w-screen min-h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8">
    <a
      class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg"
      href={lang === DEFAULT_LANGUAGE ? '/' : `/${lang}/`}>Back</a
    >
    <h1 class="text-4xl font-bold mb-4 text-neutral-100">
      {isRO ? 'Cartea de Oaspeți' : 'Guestbook'}
    </h1>
    <p class="text-neutral-400">
      {isRO
        ? 'Cartea de oaspeți va fi disponibilă în curând.'
        : 'Guestbook section coming soon.'}
    </p>
  </main>
</Layout>
