---
import { env } from 'cloudflare:workers';
import { DEFAULT_LANGUAGE, type Language } from '../../lib/i18n';
import Seo from '../../components/Seo.astro';
import { getPosts, getPageSeo } from '../../lib/sanity-queries';
import Layout from '../../layouts/Layout.astro';
import PostRow from '../../components/Blog/PostRow.astro';
import { SITE } from '../../site-config';
import { listPublicIncidents } from '../../lib/cyber-monitor/public-data';

export const prerender = false;

const lang: Language = 'en';
const isRO = false;

interface Post {
  id: string;
  title: string;
  pubDate: string | Date;
  href?: string;
}

let posts: Post[] = [];
try {
  const allPosts = await getPosts(lang);
  posts = allPosts.map(p => ({
    id: p.slug,
    title: p.title,
    pubDate: p.pubDate
  }));
} catch (error) {
  console.warn('Failed to fetch posts from Sanity:', error);
}

try {
  const incidents = await listPublicIncidents(env.ROMANIA_MONITOR_DB, { limit: 50 });
  const cyberMonitorPosts: Post[] = incidents.map((incident) => ({
    id: incident.slug,
    title: incident.articleTitle ?? incident.organisationDisplayName ?? 'Romania Cyber Monitor update',
    pubDate: incident.publishedAt,
    href: `/romania-cyber-monitor/incidents/${incident.slug}`,
  }));
  posts = [...posts, ...cyberMonitorPosts].sort(
    (a, b) => new Date(b.pubDate).getTime() - new Date(a.pubDate).getTime()
  );
} catch (error) {
  console.warn('Failed to fetch Romania Cyber Monitor posts:', error);
}

const seo = await getPageSeo("blog");
const seoTitle = seo?.title || `${SITE.author.fullName} - Blog`;
const seoDescription = seo?.description || "Cybersecurity articles, technical research, incident analysis, and practical security notes";
---

<script>
  import { animate, type AnimationSequence } from 'motion';
  import { loaderAnimation } from '../../lib/constants';

  const sequence = [loaderAnimation];

  animate(sequence as AnimationSequence);
</script>

<Layout
  description={seoDescription}
  title={seoTitle}
  lang={lang}
>
  <Seo
    title={seoTitle}
    description={seoDescription}
    lang={lang}
    keywords={seo?.keywords}
    ogImage={seo?.ogImage}
    canonical={`${SITE.site.url}blog`}
  />
  <main
    class="w-screen h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8"
  >
    <a
      class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg"
      href="/">Back</a
    >
    <h1 class="text-4xl font-bold mb-4 text-neutral-100">
      Posts
    </h1>
    <ul class="w-full">
      {
        posts?.map((post) => (
          <PostRow
            date={post.pubDate ? new Date(post.pubDate) : new Date()}
            id={post.id}
            title={post.title || 'No title'}
            lang={lang}
            href={post.href}
          />
        ))
      }
    </ul>
  </main>
</Layout>
