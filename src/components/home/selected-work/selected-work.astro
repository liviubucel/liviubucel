---
import Eyebrow from '@/components/shared/eyebrow/eyebrow.astro'

const WORK = [
  {
    title: 'Romania Cyber Monitor',
    eyebrow: 'Threat intelligence',
    description: 'Automated collection and normalization of Romania-linked ransomware, breach, malware, exposure, and threat-infrastructure reporting.',
    href: '/romania-cyber-monitor',
    tags: ['Threat intel', 'Automation', 'OSINT', 'Cloudflare']
  },
  {
    title: 'ZebraByte',
    eyebrow: 'Cybersecurity platform',
    description: 'Security-focused infrastructure and product work spanning hosting, defensive controls, web security, compliance, and automation.',
    href: '/projects',
    tags: ['Cybersecurity', 'Infrastructure', 'Cloudflare']
  },
  {
    title: 'SSL Certificate Generator',
    eyebrow: 'Security automation',
    description: 'ACME automation project for domain validation, certificate issuance, and deployable TLS/SSL certificate packages.',
    href: '/projects',
    tags: ['ACME', 'TLS', 'SSL', 'Automation']
  }
]
---

<section id='featured-works' class='border-b py-8 sm:py-16 lg:py-24'>
  <div class='space-y-8 px-4 sm:px-6 lg:space-y-16 lg:px-10.5'>
    <div class='space-y-2'>
      <Eyebrow text='Selected security work' />
      <h2 class='text-2xl font-semibold md:text-3xl lg:text-4xl'>Projects built around real security problems</h2>
    </div>
    <div class='grid gap-5 md:grid-cols-2'>
      {WORK.map((item, index) => (
        <a href={item.href} class:list={['group rounded-3xl border bg-card p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg', index === 0 && 'md:col-span-2']}>
          <div class='flex h-full min-h-56 flex-col justify-between gap-8'>
            <div>
              <p class='text-accent text-xs font-semibold uppercase tracking-widest'>{item.eyebrow}</p>
              <h3 class='mt-3 text-2xl font-semibold md:text-3xl'>{item.title}</h3>
              <p class='text-muted-foreground mt-3 max-w-2xl text-base'>{item.description}</p>
            </div>
            <div class='flex flex-wrap items-center justify-between gap-3'>
              <div class='flex flex-wrap gap-2'>{item.tags.map(tag => <span class='rounded-full bg-(--background-darker) px-3 py-1 text-xs font-medium'>{tag}</span>)}</div>
              <span class='text-accent font-medium transition group-hover:translate-x-1'>Explore →</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
