---
import type { Language } from '../lib/i18n';
import Layout from '../layouts/Layout.astro';
import GuestbookForm from '../components/GuestbookForm.astro';
import GuestbookEntries from '../components/GuestbookEntries.astro';
import { SITE } from '../site-config';
import { getGuestbookEntries } from '../lib/sanity-queries';

const lang: Language = 'en';
const entries = await getGuestbookEntries(lang);

const labels = {
  en: {
    title: 'Guestbook',
    description: 'Sign my guestbook',
    entriesTitle: 'Recent Entries',
  },
  ro: {
    title: 'Cartea de Oaspeți',
    description: 'Semnează cartea mea de oaspeți',
    entriesTitle: 'Intrări Recente',
  },
};

const t = labels[lang];
---

<Layout
  description={t.description}
  title={`${SITE.author.fullName} - ${t.title}`}
  lang={lang}
>
  <main class="w-screen min-h-screen flex flex-col justify-center items-center max-w-3xl mx-auto p-8">
    <a
      class="absolute top-8 left-8 text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 border-1 border-solid border-neutral-600 rounded-lg"
      href={lang === 'en' ? '/' : '/ro'}
    >
      Back
    </a>

    <h1 class="text-4xl font-bold mb-12 text-neutral-100 text-center">
      {t.title}
    </h1>

    <div class="w-full max-w-2xl grid grid-cols-1 lg:grid-cols-2 gap-12">
      <div class="flex flex-col">
        <GuestbookForm lang={lang} />
      </div>

      <div class="flex flex-col">
        <h2 class="text-2xl font-bold mb-8 text-neutral-100">
          {t.entriesTitle}
        </h2>
        <GuestbookEntries entries={entries} lang={lang} />
      </div>
    </div>
  </main>
</Layout>
