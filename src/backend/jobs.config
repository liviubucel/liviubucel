{
  "jobs": [
    {
      "functionLocation": "/romaniaCyberMonitor.js",
      "functionName": "runFastFeeds",
      "description": "Romania Cyber Monitor fast-moving ransomware and IOC feeds",
      "executionConfig": {
        "cronExpression": "0 */6 * * *"
      }
    },
    {
      "functionLocation": "/romaniaCyberMonitor.js",
      "functionName": "runTwelveHourlyFeeds",
      "description": "Romania Cyber Monitor HIBP and malware metadata feeds",
      "executionConfig": {
        "cronExpression": "0 */12 * * *"
      }
    },
    {
      "functionLocation": "/romaniaCyberMonitor.js",
      "functionName": "runDailyFeeds",
      "description": "Romania Cyber Monitor daily catalogue refresh",
      "executionConfig": {
        "cronExpression": "0 3 * * *"
      }
    },
    {
      "functionLocation": "/romaniaCyberMonitor.js",
      "functionName": "runWeeklyFeeds",
      "description": "Romania Cyber Monitor weekly aggregate sources",
      "executionConfig": {
        "cronExpression": "0 4 * * 1"
      }
    }
  ]
}
