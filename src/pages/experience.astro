---
import type { Language } from "../lib/i18n";
import Layout from "../layouts/Layout.astro";
import Seo from "../components/Seo.astro";
import { SITE } from "../site-config";

const lang: Language = "en";
---

<Layout
  title={"Relevant Experience — " + SITE.author.fullName}
  description="Relevant technical support, infrastructure, and cybersecurity experience across ZebraByte, Intact Media Group, and practical security labs."
  lang={lang}
>
  <Seo
    title={"Relevant Experience — " + SITE.author.fullName}
    description="Relevant technical support, infrastructure, and cybersecurity experience across ZebraByte, Intact Media Group, and practical security labs."
    lang={lang}
    canonical={SITE.site.url + "experience"}
  />

  <main class="min-h-screen text-white px-4 py-16 md:py-24 max-w-5xl mx-auto">
    <a
      class="absolute top-4 left-4 md:top-8 md:left-8 text-white bg-neutral-900 hover:bg-neutral-800 px-3 py-1 md:px-4 md:py-2 text-sm border border-neutral-600 rounded-lg transition-colors duration-150"
      href="/"
    >
      ← Back
    </a>

    <header class="mt-12 md:mt-0 mb-12">
      <p class="text-xs font-medium text-neutral-500 uppercase tracking-widest mb-3">Career profile</p>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight tracking-tight text-neutral-100 mb-4">
        Relevant experience
      </h1>
      <p class="text-neutral-400 text-base leading-relaxed max-w-3xl">
        My background connects IT support, hosting infrastructure, and practical cybersecurity work, with a focus on DFIR, security operations, and security testing.
      </p>
    </header>

    <div class="space-y-6">
      <article class="rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-7">
        <div class="flex flex-col gap-1 md:flex-row md:items-start md:justify-between mb-4">
          <div>
            <h2 class="text-xl font-bold text-neutral-100">Technical Support Specialist</h2>
            <p class="text-primary-400 font-medium">ZebraByte</p>
          </div>
          <p class="text-sm text-neutral-500">April 2022 – January 2024 · United Kingdom</p>
        </div>
        <ul class="list-disc pl-5 space-y-2 text-sm text-neutral-300 leading-relaxed">
          <li>Provided Level 1 support for web-hosting environments and client infrastructure.</li>
          <li>Configured and troubleshot cPanel accounts, DNS records, domain routing, and email delivery.</li>
          <li>Installed and renewed SSL certificates using ACME and Let's Encrypt.</li>
          <li>Supported WordPress deployments and diagnosed website-connectivity issues.</li>
          <li>Applied basic infrastructure protection using Cloudflare and documented recurring support issues.</li>
        </ul>
      </article>

      <article class="rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-7">
        <div class="flex flex-col gap-1 md:flex-row md:items-start md:justify-between mb-4">
          <div>
            <h2 class="text-xl font-bold text-neutral-100">IT Technician</h2>
            <p class="text-primary-400 font-medium">Intact Media Group</p>
          </div>
          <p class="text-sm text-neutral-500">November 2019 – September 2020 · Bucharest, Romania</p>
        </div>
        <ul class="list-disc pl-5 space-y-2 text-sm text-neutral-300 leading-relaxed">
          <li>Provided Level 1 IT support in a fast-paced media production environment.</li>
          <li>Troubleshot Windows, workstation, application, email, and network-connectivity issues.</li>
          <li>Configured user workstations and supported office and internal applications.</li>
          <li>Escalated complex incidents to infrastructure and system-administration teams.</li>
        </ul>
      </article>

      <section class="rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-7">
        <h2 class="text-xl font-bold text-neutral-100 mb-4">Practical cybersecurity work</h2>
        <ul class="list-disc pl-5 space-y-2 text-sm text-neutral-300 leading-relaxed">
          <li>Cybersecurity threat-analysis simulation using current CISA publications and remediation guidance.</li>
          <li>Mastercard security-awareness job simulation focused on phishing risk and training needs.</li>
          <li>Controlled Python exercise for testing decryption keys and understanding brute-force logic.</li>
          <li>Hands-on labs covering Linux, Windows, networking, reconnaissance, enumeration, and incident-response fundamentals.</li>
          <li>Tools used include Kali Linux, Wireshark, Burp Suite, Nmap, PowerShell, and Python.</li>
        </ul>
      </section>

      <section class="rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-7">
        <p class="text-xs font-medium text-neutral-500 uppercase tracking-widest mb-2">Education</p>
        <h2 class="text-xl font-bold text-neutral-100">BSc (Hons) Cyber Security</h2>
        <p class="text-primary-400 font-medium">De Montfort University</p>
        <p class="text-sm text-neutral-400 mt-2">October 2024 – July 2027 (expected)</p>
        <p class="text-sm text-neutral-300 leading-relaxed mt-3">
          Relevant areas include networking, Linux, secure coding, penetration testing, incident response, system hardening, and threat detection.
        </p>
      </section>
    </div>

    <section class="mt-16 rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-7">
      <h2 class="text-2xl font-bold text-neutral-100 mb-2">Download CV</h2>
      <p class="text-sm text-neutral-400 mb-6">
        Request access to my CV. For security, download links are time-limited and verified using secure tokens.
      </p>

      <form id="cv-request-form" class="space-y-4 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="fullname" class="block text-sm font-medium text-neutral-300 mb-2">Full Name</label>
            <input
              type="text"
              id="fullname"
              name="fullname"
              required
              class="w-full px-4 py-2 rounded-lg bg-neutral-700 border border-neutral-600 text-white placeholder-neutral-500 focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
              placeholder="Your full name"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-neutral-300 mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-2 rounded-lg bg-neutral-700 border border-neutral-600 text-white placeholder-neutral-500 focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
              placeholder="your.email@company.com"
            />
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-neutral-300 mb-2">Phone</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full px-4 py-2 rounded-lg bg-neutral-700 border border-neutral-600 text-white placeholder-neutral-500 focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
              placeholder="+1 (555) 123-4567"
            />
          </div>
          <div>
            <label for="company" class="block text-sm font-medium text-neutral-300 mb-2">Company / Organization</label>
            <input
              type="text"
              id="company"
              name="company"
              class="w-full px-4 py-2 rounded-lg bg-neutral-700 border border-neutral-600 text-white placeholder-neutral-500 focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
              placeholder="Your company name"
            />
          </div>
        </div>

        <div class="flex items-start gap-3">
          <input
            type="checkbox"
            id="terms"
            name="terms"
            required
            class="mt-1 w-4 h-4 rounded bg-neutral-700 border border-neutral-600 text-primary-600 focus:ring-primary-500 cursor-pointer"
          />
          <label for="terms" class="text-sm text-neutral-400">
            I agree that my information may be used to send me my CV securely. The link will expire in 24 hours.
          </label>
        </div>

        <div class="flex gap-3">
          <button
            type="submit"
            class="px-6 py-2.5 rounded-lg bg-white text-darkslate-900 font-semibold hover:bg-neutral-50 transition-colors border border-neutral-300 shadow-sm active:shadow-none active:translate-y-[1px]"
          >
            Request CV
          </button>
          <button
            type="reset"
            class="px-6 py-2.5 rounded-lg bg-neutral-900 text-white font-semibold hover:bg-neutral-800 transition-colors border border-neutral-600"
          >
            Clear
          </button>
        </div>

        <div id="form-message" class="hidden mt-4 p-4 rounded-lg text-sm bg-neutral-900/50 border border-neutral-700"></div>
      </form>

      <div class="bg-neutral-900/50 rounded-lg p-4 border border-neutral-700">
        <p class="text-xs font-medium text-neutral-400 uppercase tracking-wider mb-2">Security notice</p>
        <ul class="space-y-2 text-sm text-neutral-400">
          <li class="flex gap-2">
            <span class="text-primary-400 flex-shrink-0">✓</span>
            <span>Download links are secured with cryptographic tokens to prevent unauthorized access.</span>
          </li>
          <li class="flex gap-2">
            <span class="text-primary-400 flex-shrink-0">✓</span>
            <span>Each link expires 24 hours after generation to limit exposure window.</span>
          </li>
          <li class="flex gap-2">
            <span class="text-primary-400 flex-shrink-0">✓</span>
            <span>Your information is used only to deliver your CV and will not be shared.</span>
          </li>
        </ul>
      </div>
    </section>

    <div class="mt-10 flex flex-wrap gap-3">
      <a class="rounded-xl border border-neutral-600 bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-neutral-800 transition-colors duration-150" href="/projects">
        View projects
      </a>
      <a class="rounded-xl border border-neutral-600 bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-neutral-800 transition-colors duration-150" href="/contact">
        Contact me
      </a>
      <a class="rounded-xl border border-neutral-600 bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-neutral-800 transition-colors duration-150" href={SITE.links.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn
      </a>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('cv-request-form') as HTMLFormElement;
  const messageDiv = document.getElementById('form-message') as HTMLDivElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      messageDiv.classList.remove('hidden', 'text-red-300', 'text-green-300');
      messageDiv.textContent = 'Sending your request...';
      messageDiv.classList.add('text-neutral-300');

      try {
        const response = await fetch('/api/cv-request', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = await response.json();

        if (response.ok) {
          messageDiv.textContent = 'Success! Check your email for your CV download link. Link expires in 24 hours.';
          messageDiv.classList.remove('text-neutral-300');
          messageDiv.classList.add('text-green-300');
          form.reset();
        } else {
          messageDiv.textContent = result.error || 'Failed to send request. Please try again.';
          messageDiv.classList.remove('text-neutral-300');
          messageDiv.classList.add('text-red-300');
        }
      } catch (error) {
        messageDiv.textContent = 'Error sending request. Please try again later.';
        messageDiv.classList.remove('text-neutral-300');
        messageDiv.classList.add('text-red-300');
      }
    });
  }
</script>
