---
import { DEFAULT_LANGUAGE, type Language } from '../../../lib/i18n';
import Seo from '../../../components/Seo.astro';
import { getPosts } from '../../../lib/sanity-queries';
import Layout from '../../../layouts/Layout.astro';
import PostRow from '../../../components/Blog/PostRow.astro';
import { SITE } from '../../../site-config';

const lang: Language = 'ro';
const isRO = true;

interface Post {
  id: string;
  title: string;
  pubDate: string | Date;
}

let posts: Post[] = [];
try {
  // Try RO posts first, fall back to EN (no separate RO posts yet)
  let allPosts = await getPosts(lang);
  if (allPosts.length === 0) {
    allPosts = await getPosts('en');
  }
  posts = allPosts.map(p => ({
    id: p.slug,
    title: p.title,
    pubDate: p.pubDate
  }));
} catch (error) {
  console.warn('Failed to fetch posts from Sanity:', error);
}
---

<script>
  import { animate, type AnimationSequence } from 'motion';
  import { loaderAnimation } from '../../../lib/constants';

  const sequence = [loaderAnimation];

  animate(sequence as AnimationSequence);
</script>

<Layout
  description="Articole de securitate cibernetică, cercetare tehnică și analiză practică"
  title={`${SITE.author.fullName} - Blog`}
  lang={lang}
>
  <Seo
    title={`${SITE.author.fullName} - Blog`}
    description="Articole de securitate cibernetică, cercetare tehnică și analiză practică"
    lang={lang}
    canonical={`${SITE.site.url}ro/blog`}
  />
  <main
    class="w-screen h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8"
  >
    <a
      class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg"
      href="/ro/">Înapoi</a
    >
    <h1 class="text-4xl font-bold mb-4 text-neutral-100">
      Articole
    </h1>
    <ul class="w-full">
      {
        posts?.map((post) => (
          <PostRow
            date={post.pubDate ? new Date(post.pubDate) : new Date()}
            id={post.id}
            title={post.title || 'Fără titlu'}
            lang={lang}
          />
        ))
      }
    </ul>
  </main>
</Layout>
