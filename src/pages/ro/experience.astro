---
import type { Language } from "../../lib/i18n";
import Layout from "../../layouts/Layout.astro";
import Seo from "../../components/Seo.astro";
import { SITE } from "../../site-config";

const lang: Language = "ro";
---

<Layout
  title={"Experiență relevantă — " + SITE.author.fullName}
  description="Experiență relevantă în suport tehnic, infrastructură și securitate cibernetică la ZebraByte, Intact Media Group și în laboratoare practice."
  lang={lang}
>
  <Seo
    title={"Experiență relevantă — " + SITE.author.fullName}
    description="Experiență relevantă în suport tehnic, infrastructură și securitate cibernetică la ZebraByte, Intact Media Group și în laboratoare practice."
    lang={lang}
    canonical={SITE.site.url + "ro/experience"}
  />

  <main class="min-h-screen text-white px-4 py-16 md:py-24 max-w-5xl mx-auto">
    <a
      class="absolute top-4 left-4 md:top-8 md:left-8 text-white bg-neutral-900 hover:bg-neutral-800 px-3 py-1 md:px-4 md:py-2 text-sm border border-neutral-600 rounded-lg transition-colors duration-150"
      href="/ro"
    >
      ← Înapoi
    </a>

    <header class="mt-12 md:mt-0 mb-12">
      <p class="text-xs font-medium text-neutral-500 uppercase tracking-widest mb-3">Profil profesional</p>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight tracking-tight text-neutral-100 mb-4">
        Experiență relevantă
      </h1>
      <p class="text-neutral-400 text-base leading-relaxed max-w-3xl">
        Parcursul meu leagă suportul IT, infrastructura de hosting și activitatea practică de securitate cibernetică. Urmăresc roluri junior și graduate în cybersecurity, DFIR, security operations și security testing.
      </p>
    </header>

    <div class="space-y-6">
      <article class="rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-7">
        <div class="flex flex-col gap-1 md:flex-row md:items-start md:justify-between mb-4">
          <div>
            <h2 class="text-xl font-bold text-neutral-100">Technical Support Specialist</h2>
            <p class="text-primary-400 font-medium">ZebraByte</p>
          </div>
          <p class="text-sm text-neutral-500">Aprilie 2022 – ianuarie 2024 · Regatul Unit</p>
        </div>
        <ul class="list-disc pl-5 space-y-2 text-sm text-neutral-300 leading-relaxed">
          <li>Suport Level 1 pentru medii de web hosting și infrastructura clienților.</li>
          <li>Configurare și depanare pentru conturi cPanel, înregistrări DNS, domenii și rutare email.</li>
          <li>Instalare și reînnoire certificate SSL prin ACME și Let's Encrypt.</li>
          <li>Suport pentru WordPress și diagnosticarea problemelor de conectivitate ale site-urilor.</li>
          <li>Protecție de bază a infrastructurii prin Cloudflare și documentarea problemelor recurente.</li>
        </ul>
      </article>

      <article class="rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-7">
        <div class="flex flex-col gap-1 md:flex-row md:items-start md:justify-between mb-4">
          <div>
            <h2 class="text-xl font-bold text-neutral-100">IT Technician</h2>
            <p class="text-primary-400 font-medium">Intact Media Group</p>
          </div>
          <p class="text-sm text-neutral-500">Noiembrie 2019 – septembrie 2020 · București, România</p>
        </div>
        <ul class="list-disc pl-5 space-y-2 text-sm text-neutral-300 leading-relaxed">
          <li>Suport IT Level 1 într-un mediu rapid de producție media.</li>
          <li>Depanare Windows, stații de lucru, aplicații, email și conectivitate de rețea.</li>
          <li>Configurarea stațiilor utilizatorilor și suport pentru aplicații office și interne.</li>
          <li>Escaladarea incidentelor complexe către echipele de infrastructură și administrare sisteme.</li>
        </ul>
      </article>

      <section class="rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-7">
        <h2 class="text-xl font-bold text-neutral-100 mb-4">Activitate practică în cybersecurity</h2>
        <ul class="list-disc pl-5 space-y-2 text-sm text-neutral-300 leading-relaxed">
          <li>Simulare de threat analysis folosind publicații CISA și recomandări de remediere.</li>
          <li>Simulare Mastercard de security awareness axată pe phishing și nevoile de training.</li>
          <li>Exercițiu controlat în Python pentru testarea cheilor de decriptare și înțelegerea logicii brute force.</li>
          <li>Laboratoare practice de Linux, Windows, networking, reconnaissance, enumeration și incident response.</li>
          <li>Instrumente folosite: Kali Linux, Wireshark, Burp Suite, Nmap, PowerShell și Python.</li>
        </ul>
      </section>

      <section class="rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-7">
        <p class="text-xs font-medium text-neutral-500 uppercase tracking-widest mb-2">Educație</p>
        <h2 class="text-xl font-bold text-neutral-100">BSc (Hons) Cyber Security</h2>
        <p class="text-primary-400 font-medium">De Montfort University</p>
        <p class="text-sm text-neutral-400 mt-2">Octombrie 2024 – iulie 2027 (finalizare estimată)</p>
        <p class="text-sm text-neutral-300 leading-relaxed mt-3">
          Domenii relevante: networking, Linux, secure coding, penetration testing, incident response, system hardening și threat detection.
        </p>
      </section>
    </div>

    <div class="mt-10 flex flex-wrap gap-3">
      <a class="rounded-xl bg-primary-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-primary-500 transition-colors duration-150" href="/ro/projects">
        Vezi proiectele
      </a>
      <a class="rounded-xl border border-neutral-600 bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-neutral-800 transition-colors duration-150" href="/ro/contact">
        Contactează-mă
      </a>
      <a class="rounded-xl border border-neutral-600 bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-neutral-800 transition-colors duration-150" href={SITE.links.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn
      </a>
    </div>
  </main>
</Layout>
