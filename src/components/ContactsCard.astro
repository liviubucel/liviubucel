---
import Card from "./Card/index.astro";
import { Icon } from "astro-icon/components";
import { getCertifications, type ProfileSettings, type Certification } from "../lib/sanity-queries";

interface Props {
  lang?: "en" | "ro";
  profile?: ProfileSettings | null;
  certifications?: Certification[];
}

const { lang = "en", certifications: certificationsProp } = Astro.props;
const isRO = lang === "ro";

let certs = certificationsProp !== undefined ? certificationsProp : await getCertifications();

if (!certs.length) {
  certs = [
    { _id: '1', name: 'OWASP Member', issuer: 'OWASP', status: 'earned', iconType: 'owasp' },
    { _id: '2', name: 'CompTIA Security+', issuer: 'CompTIA', status: 'in-progress', iconType: 'comptia' },
    { _id: '3', name: 'CCNA', issuer: 'Cisco', status: 'planned', iconType: 'cisco' },
  ] as any;
}

const iconName = (iconType: string) => {
  const icons: Record<string, string> = {
    owasp: 'simple-icons:owasp',
    comptia: 'simple-icons:comptia',
    cisco: 'simple-icons:cisco',
    isc2: 'simple-icons:isc2',
    fortinet: 'simple-icons:fortinet',
    paloaltonetworks: 'simple-icons:paloaltonetworks',
    microsoft: 'simple-icons:microsoft',
    googlecloud: 'simple-icons:googlecloud',
    ibm: 'simple-icons:ibm',
    redhat: 'simple-icons:redhat',
    vmware: 'simple-icons:vmware',
    junipernetworks: 'simple-icons:junipernetworks',
    splunk: 'simple-icons:splunk',
    sonicwall: 'simple-icons:sonicwall',
    kalilinux: 'simple-icons:kalilinux',
    linuxprofessionalinstitute: 'simple-icons:linuxprofessionalinstitute',
    hackthebox: 'simple-icons:hackthebox',
    tryhackme: 'simple-icons:tryhackme',
    hackerone: 'simple-icons:hackerone',
    shield: 'ri:shield-check-line',
    network: 'ri:router-line',
    bug: 'ri:bug-line',
    terminal: 'ri:terminal-box-line',
    lock: 'ri:lock-2-line',
    award: 'ri:award-line',
  };

  return icons[iconType] ?? 'ri:award-line';
};

const media = [
  { name: 'PRO TV', src: 'https://i.imgur.com/zVk3WlT.png' },
  { name: 'Agro TV', src: 'https://i.imgur.com/S7X1PiC.png' },
  { name: 'Antena 3 CNN', src: 'https://static.wikia.nocookie.net/logopedia/images/8/82/Antena_3_CNN_2022_v1.png/revision/latest/scale-to-width-down/512' },
  { name: 'B1 TV', src: 'https://upload.wikimedia.org/wikipedia/commons/thumb/5/57/B1_TV_logo.svg/960px-B1_TV_logo.svg.png' },
];
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-4">
  <div class="h-full flex flex-col">
    <section>
      <h2 class="text-white text-xl font-bold m-0">
        {isRO ? "Acreditări" : "Credentials"}
      </h2>

      <div class="grid grid-cols-3 gap-x-5 gap-y-5 mt-5 items-center">
        {certs.map((cert) => {
          const Tag = cert.credentialUrl ? 'a' : 'div';
          return (
            <Tag
              data-card-logo
              class="h-12 flex items-center justify-center text-neutral-200 hover:text-white hover:-translate-y-1 transition-all duration-200"
              title={cert.name}
              aria-label={cert.name}
              {...(cert.credentialUrl ? { href: cert.credentialUrl, target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <Icon name={iconName(cert.iconType)} class="h-10 w-10 max-w-full" />
            </Tag>
          );
        })}
      </div>
    </section>

    <section class="mt-auto pt-5 border-t border-darkslate-700/70">
      <h2 class="text-white text-xl font-bold m-0">Media</h2>

      <div class="grid grid-cols-2 gap-x-5 gap-y-5 mt-5 items-center">
        {media.map((item) => (
          <div
            data-card-logo
            class="h-12 flex items-center justify-center hover:-translate-y-1 transition-transform duration-200"
            title={item.name}
            aria-label={item.name}
          >
            <img
              src={item.src}
              alt={item.name}
              loading="lazy"
              decoding="async"
              class="max-h-9 max-w-[82px] object-contain"
              style="filter: grayscale(1) brightness(0) invert(1); opacity: .82;"
            />
          </div>
        ))}
      </div>
    </section>
  </div>
</Card>

<script>
  import { animate, stagger } from "motion";

  const logos = document.querySelectorAll("[data-card-logo]");
  if (logos.length) {
    animate(
      logos,
      { opacity: [0, 1], y: [8, 0] },
      { delay: stagger(0.05, { startDelay: 0.18 }), duration: 0.32, ease: "easeOut" },
    );
  }
</script>
