---
import { Button } from '@/components/ui/button'
import { Separator } from '@/components/ui/separator'
const socials = [
  { label: 'GitHub', src: '/images/footer/github-logo.webp', href: 'https://github.com/liviubucel' },
  { label: 'Email', src: '/images/footer/gmail.webp', href: 'mailto:contact@liviubucel.com' },
  { label: 'LinkedIn', src: '/images/footer/linkedin.webp', href: 'https://www.linkedin.com/in/liviubucel/' },
  { label: 'X', src: '/images/footer/twitter.webp', href: 'https://x.com/liviubucel' }
]
const year = new Date().getFullYear()
---

<footer class='lg:px-10.5'>
  <div class='mx-auto max-w-4xl space-y-12 pb-12 lg:border-x xl:max-w-245'>
    <div class='flex items-center gap-3'>
      <Separator className='flex-1' />
      <div class='flex items-center gap-3'>{socials.map(social => <a href={social.href} target={social.href.startsWith('http') ? '_blank' : undefined} rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined} aria-label={social.label}><Button variant='outline' size='icon' className='hover:bg-muted/5 min-w-10 rounded-md'><img src={social.src} alt='' width={16} height={16} /></Button></a>)}</div>
      <Separator className='flex-1' />
    </div>
    <div class='mb-8 flex items-center justify-center gap-5 text-center max-lg:hidden xl:ml-8'><p class='text-muted-foreground'>Thank you for visiting</p><img src='/images/footer/tree-seal.webp' alt='' class='size-25' /><p class='text-muted-foreground'>Keep learning. Keep testing.</p></div>
    <div class='-ml-5 space-y-1 text-center'><img src='/images/footer/signature.webp' alt='' class='mx-auto -mb-6 w-60' /><p class='text-xs'>@Liviu Bucel {year}</p></div>
  </div>
</footer>
