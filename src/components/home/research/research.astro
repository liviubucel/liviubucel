---
import Eyebrow from '@/components/shared/eyebrow/eyebrow.astro'
const status = Astro.url.searchParams.get('newsletter')
---

<section id='research' class='border-b py-8 sm:py-16 lg:py-24'>
  <div class='space-y-8 px-4 sm:px-6 lg:space-y-16 lg:px-10.5'>
    <div class='space-y-2'>
      <Eyebrow text='Research & writing' />
      <h2 class='text-2xl font-semibold md:text-3xl lg:text-4xl'>Follow the investigations, notes, and threat updates</h2>
    </div>
    <div class='grid gap-5 md:grid-cols-2'>
      <a href='/romania-cyber-monitor' class='rounded-3xl border bg-card p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg'>
        <p class='text-accent text-xs font-semibold uppercase tracking-widest'>Live intelligence</p>
        <h3 class='mt-3 text-2xl font-semibold'>Romania Cyber Monitor</h3>
        <p class='text-muted-foreground mt-3'>Track public ransomware claims, breaches, malware, exposures, and threat infrastructure linked to Romania.</p>
      </a>
      <a href='/blog' class='rounded-3xl border bg-card p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-lg'>
        <p class='text-accent text-xs font-semibold uppercase tracking-widest'>Writing</p>
        <h3 class='mt-3 text-2xl font-semibold'>Security notes & analysis</h3>
        <p class='text-muted-foreground mt-3'>Longer-form notes on cybersecurity, incidents, research, tooling, and practical security work.</p>
      </a>
    </div>

    <div class='rounded-3xl border bg-(--background-darker) p-6 sm:p-8'>
      <div class='grid gap-6 md:grid-cols-[1fr_auto] md:items-end'>
        <div>
          <p class='text-sm font-semibold'>Romania Cyber Monitor alerts</p>
          <h3 class='mt-2 text-xl font-semibold'>Get notified when new Romania-linked incidents are published.</h3>
          <p class='text-muted-foreground mt-2 text-sm'>Double opt-in. No spam. Unsubscribe anytime.</p>
        </div>
        <form id='zolt-newsletter' class='flex w-full max-w-md flex-col gap-2 sm:flex-row' data-status={status || ''}>
          <input class='bg-background h-11 min-w-0 flex-1 rounded-full border px-4 text-sm outline-none focus:ring-2 focus:ring-accent/40' type='email' name='email' autocomplete='email' maxlength='254' required placeholder='you@example.com' />
          <input type='hidden' name='consent' value='on' />
          <button class='bg-primary text-primary-foreground h-11 rounded-full px-5 text-sm font-semibold' type='submit'>Subscribe</button>
        </form>
      </div>
      <p id='zolt-newsletter-status' class='text-muted-foreground mt-3 text-sm' role='status' aria-live='polite'></p>
      <p class='text-muted-foreground mt-2 text-xs'>By subscribing, you agree to the <a class='underline hover:text-foreground' href='/privacy'>Privacy Policy</a>.</p>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector('#zolt-newsletter') as HTMLFormElement | null
  const message = document.querySelector('#zolt-newsletter-status') as HTMLElement | null
  if (form && message) {
    const current = form.dataset.status
    if (current === 'confirmed') message.textContent = "You're subscribed."
    if (current === 'unsubscribed') message.textContent = "You've been unsubscribed."
    if (current === 'invalid') message.textContent = 'That confirmation link is invalid or expired.'
    form.addEventListener('submit', async event => {
      event.preventDefault()
      const button = form.querySelector('button') as HTMLButtonElement
      button.disabled = true
      message.textContent = 'Sending confirmation…'
      try {
        const response = await fetch('/api/newsletter/subscribe', { method: 'POST', body: new FormData(form) })
        const data = await response.json() as { success?: boolean; error?: string; alreadySubscribed?: boolean }
        if (!response.ok || !data.success) throw new Error(data.error || 'Subscription failed.')
        message.textContent = data.alreadySubscribed ? "You're already subscribed." : 'Check your inbox to confirm your subscription.'
        form.reset()
      } catch (error) {
        message.textContent = error instanceof Error ? error.message : 'Something went wrong. Please try again.'
      } finally { button.disabled = false }
    })
  }
</script>
