---
import Card from "./Card/index.astro";
import { Icon } from "astro-icon/components";
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-1"
  title="Curriculum Vitae"
  href="/cv"
>
  <div class="flex flex-col gap-2 mt-4 h-full">
    <p class="text-sm text-darkslate-300 m-0">View or download my professional CV including education, certifications and projects.</p>
    <div class="flex items-center gap-2 text-primary-500 mt-auto font-bold">
      <Icon name="ri:download-line" class="h-5 w-5" />
      Download CV
    </div>
  </div>
</Card>
