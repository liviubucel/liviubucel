---
import type { Language } from "../../lib/i18n";
import Layout from "../../layouts/Layout.astro";
import Seo from "../../components/Seo.astro";
import { SITE } from "../../site-config";
import { getPageSeo } from "../../lib/sanity-queries";

const lang: Language = "ro";

const seo = await getPageSeo("experience-ro");
const seoTitle = seo?.title || "Experiență relevantă — " + SITE.author.fullName;
const seoDescription = seo?.description || "Experiență relevantă în suport tehnic, infrastructură și securitate cibernetică la ZebraByte, Intact Media Group și în laboratoare practice.";
---

<Layout
  title={seoTitle}
  description={seoDescription}
  lang={lang}
>
  <Seo
    title={seoTitle}
    description={seoDescription}
    lang={lang}
    keywords={seo?.keywords}
    ogImage={seo?.ogImage}
    canonical={SITE.site.url + "ro/experience"}
  />

  <main class="min-h-screen text-white px-4 py-16 md:py-24 max-w-5xl mx-auto">
    <a
      class="absolute top-4 left-4 md:top-8 md:left-8 text-white bg-neutral-900 hover:bg-neutral-800 px-3 py-1 md:px-4 md:py-2 text-sm border border-neutral-600 rounded-lg transition-colors duration-150"
      href="/ro"
    >
      ← Înapoi
    </a>

    <header class="mt-12 md:mt-0 mb-12">
      <p class="text-xs font-medium text-neutral-500 uppercase tracking-widest mb-3">Profil profesional</p>
      <h1 class="text-3xl md:text-4xl font-bold leading-tight tracking-tight text-neutral-100 mb-4">
        Experiență relevantă
      </h1>
      <p class="text-neutral-400 text-base leading-relaxed max-w-3xl">
        Parcursul meu leagă suportul IT, infrastructura de hosting și activitatea practică de securitate cibernetică, cu accent pe DFIR, security operations și security testing.
      </p>
    </header>

    <div class="space-y-6">
      <article class="rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-7">
        <div class="flex flex-col gap-1 md:flex-row md:items-start md:justify-between mb-4">
          <div>
            <h2 class="text-xl font-bold text-neutral-100">Technical Support Specialist</h2>
            <p class="text-primary-400 font-medium">ZebraByte</p>
          </div>
          <p class="text-sm text-neutral-500">Aprilie 2022 – ianuarie 2024 · Regatul Unit</p>
        </div>
        <ul class="list-disc pl-5 space-y-2 text-sm text-neutral-300 leading-relaxed">
          <li>Suport Level 1 pentru medii de web hosting și infrastructura clienților.</li>
          <li>Configurare și depanare pentru conturi cPanel, înregistrări DNS, domenii și rutare email.</li>
          <li>Instalare și reînnoire certificate SSL prin ACME și Let's Encrypt.</li>
          <li>Suport pentru WordPress și diagnosticarea problemelor de conectivitate ale site-urilor.</li>
          <li>Protecție de bază a infrastructurii prin Cloudflare și documentarea problemelor recurente.</li>
        </ul>
      </article>

      <article class="rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-7">
        <div class="flex flex-col gap-1 md:flex-row md:items-start md:justify-between mb-4">
          <div>
            <h2 class="text-xl font-bold text-neutral-100">IT Technician</h2>
            <p class="text-primary-400 font-medium">Intact Media Group</p>
          </div>
          <p class="text-sm text-neutral-500">Noiembrie 2019 – septembrie 2020 · București, România</p>
        </div>
        <ul class="list-disc pl-5 space-y-2 text-sm text-neutral-300 leading-relaxed">
          <li>Suport IT Level 1 într-un mediu rapid de producție media.</li>
          <li>Depanare Windows, stații de lucru, aplicații, email și conectivitate de rețea.</li>
          <li>Configurarea stațiilor utilizatorilor și suport pentru aplicații office și interne.</li>
          <li>Escaladarea incidentelor complexe către echipele de infrastructură și administrare sisteme.</li>
        </ul>
      </article>

      <section class="rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-7">
        <h2 class="text-xl font-bold text-neutral-100 mb-4">Activitate practică în cybersecurity</h2>
        <ul class="list-disc pl-5 space-y-2 text-sm text-neutral-300 leading-relaxed">
          <li>Simulare de threat analysis folosind publicații CISA și recomandări de remediere.</li>
          <li>Simulare Mastercard de security awareness axată pe phishing și nevoile de training.</li>
          <li>Exercițiu controlat în Python pentru testarea cheilor de decriptare și înțelegerea logicii brute force.</li>
          <li>Laboratoare practice de Linux, Windows, networking, reconnaissance, enumeration și incident response.</li>
          <li>Instrumente folosite: Kali Linux, Wireshark, Burp Suite, Nmap, PowerShell și Python.</li>
        </ul>
      </section>
    </div>

    <section class="mt-16 rounded-xl border border-neutral-700 bg-neutral-800/30 p-5 md:p-7">
      <h2 class="text-2xl font-bold text-neutral-100 mb-2">Descarcă CV-ul</h2>
      <p class="text-sm text-neutral-400 mb-6">
        Solicită acces la CV-ul meu. Din motive de securitate, linkurile de descărcare sunt limitate în timp și verificate prin token-uri securizate.
      </p>

      <form id="cv-request-form" class="space-y-4 mb-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label for="fullname" class="block text-sm font-medium text-neutral-300 mb-2">Nume complet</label>
            <input
              type="text"
              id="fullname"
              name="fullname"
              required
              class="w-full px-4 py-2 rounded-lg bg-neutral-700 border border-neutral-600 text-white placeholder-neutral-500 focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
              placeholder="Numele tău complet"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-neutral-300 mb-2">Email</label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-2 rounded-lg bg-neutral-700 border border-neutral-600 text-white placeholder-neutral-500 focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
              placeholder="numele.tau@companie.com"
            />
          </div>
          <div>
            <label for="phone" class="block text-sm font-medium text-neutral-300 mb-2">Telefon</label>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="w-full px-4 py-2 rounded-lg bg-neutral-700 border border-neutral-600 text-white placeholder-neutral-500 focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
              placeholder="+40 712 345 678"
            />
          </div>
          <div>
            <label for="company" class="block text-sm font-medium text-neutral-300 mb-2">Companie / Organizație</label>
            <input
              type="text"
              id="company"
              name="company"
              class="w-full px-4 py-2 rounded-lg bg-neutral-700 border border-neutral-600 text-white placeholder-neutral-500 focus:outline-none focus:border-primary-500 focus:ring-1 focus:ring-primary-500 transition-colors"
              placeholder="Numele companiei tale"
            />
          </div>
        </div>

        <div class="flex items-start gap-3">
          <input
            type="checkbox"
            id="terms"
            name="terms"
            required
            class="mt-1 w-4 h-4 rounded bg-neutral-700 border border-neutral-600 text-primary-600 focus:ring-primary-500 cursor-pointer"
          />
          <label for="terms" class="text-sm text-neutral-400">
            Sunt de acord ca datele mele să fie folosite pentru a-mi trimite CV-ul în siguranță. Linkul va expira în 24 de ore.
          </label>
        </div>

        <div class="flex gap-3">
          <button
            type="submit"
            class="px-6 py-2.5 rounded-lg bg-white text-darkslate-900 font-semibold hover:bg-neutral-50 transition-colors border border-neutral-300 shadow-sm active:shadow-none active:translate-y-[1px]"
          >
            Solicită CV
          </button>
          <button
            type="reset"
            class="px-6 py-2.5 rounded-lg bg-neutral-900 text-white font-semibold hover:bg-neutral-800 transition-colors border border-neutral-600"
          >
            Golește
          </button>
        </div>

        <div id="form-message" class="hidden mt-4 p-4 rounded-lg text-sm bg-neutral-900/50 border border-neutral-700"></div>
      </form>

      <div class="bg-neutral-900/50 rounded-lg p-4 border border-neutral-700">
        <p class="text-xs font-medium text-neutral-400 uppercase tracking-wider mb-2">Notă de securitate</p>
        <ul class="space-y-2 text-sm text-neutral-400">
          <li class="flex gap-2">
            <span class="text-primary-400 flex-shrink-0">✓</span>
            <span>Linkurile de descărcare sunt securizate cu token-uri criptografice pentru a preveni accesul neautorizat.</span>
          </li>
          <li class="flex gap-2">
            <span class="text-primary-400 flex-shrink-0">✓</span>
            <span>Fiecare link expiră la 24 de ore de la generare, pentru a limita fereastra de expunere.</span>
          </li>
          <li class="flex gap-2">
            <span class="text-primary-400 flex-shrink-0">✓</span>
            <span>Datele tale sunt folosite doar pentru a-ți trimite CV-ul și nu vor fi distribuite.</span>
          </li>
        </ul>
      </div>
    </section>

    <div class="mt-10 flex flex-wrap gap-3">
      <a class="rounded-xl bg-primary-600 px-5 py-2.5 text-sm font-semibold text-darkslate-900 hover:bg-primary-500 transition-colors duration-150" href="/ro/projects">
        Vezi proiectele
      </a>
      <a class="rounded-xl border border-neutral-600 bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-neutral-800 transition-colors duration-150" href="/ro/contact">
        Contactează-mă
      </a>
      <a class="rounded-xl border border-neutral-600 bg-neutral-900 px-5 py-2.5 text-sm font-semibold text-white hover:bg-neutral-800 transition-colors duration-150" href={SITE.links.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn
      </a>
    </div>
  </main>
</Layout>

<script>
  const form = document.getElementById('cv-request-form') as HTMLFormElement;
  const messageDiv = document.getElementById('form-message') as HTMLDivElement;

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      messageDiv.classList.remove('hidden', 'text-red-300', 'text-green-300');
      messageDiv.textContent = 'Se trimite cererea...';
      messageDiv.classList.add('text-neutral-300');

      try {
        const response = await fetch('/api/cv-request', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data),
        });

        const result = (await response.json()) as { error?: string };

        if (response.ok) {
          messageDiv.textContent = 'Succes! Verifică-ți emailul pentru linkul de descărcare CV. Linkul expiră în 24 de ore.';
          messageDiv.classList.remove('text-neutral-300');
          messageDiv.classList.add('text-green-300');
          form.reset();
        } else {
          messageDiv.textContent = result.error || 'Trimiterea cererii a eșuat. Te rugăm să încerci din nou.';
          messageDiv.classList.remove('text-neutral-300');
          messageDiv.classList.add('text-red-300');
        }
      } catch (error) {
        messageDiv.textContent = 'Eroare la trimiterea cererii. Te rugăm să încerci din nou mai târziu.';
        messageDiv.classList.remove('text-neutral-300');
        messageDiv.classList.add('text-red-300');
      }
    });
  }
</script>
