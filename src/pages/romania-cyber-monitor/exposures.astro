---
import { env } from 'cloudflare:workers';
import Layout from '../../layouts/Layout.astro';
import Seo from '../../components/Seo.astro';
import SectionNav from '../../components/CyberMonitor/SectionNav.astro';
import { listPublicExposures } from '../../lib/cyber-monitor/public-data';
import { SITE } from '../../site-config';

export const prerender = false;

let exposures: Awaited<ReturnType<typeof listPublicExposures>> = [];
try {
  exposures = await listPublicExposures(env.ROMANIA_MONITOR_DB, 50);
} catch (error) {
  console.error('[romania-cyber-monitor/exposures] failed to load exposures:', error);
}

const title = 'Public exposures | Romania Cyber Monitor';
const description =
  'Aggregate, monthly counts of publicly exposed services hosted in Romania. No individual IP addresses, hostnames, or organisation names are ever published here.';
---

<Layout title={title} description={description} lang="en">
  <Seo title={title} description={description} lang="en" canonical={`${SITE.site.url}romania-cyber-monitor/exposures`} />
  <main class="w-screen min-h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8">
    <a class="text-white bg-neutral-900 hover:bg-neutral-800 px-4 py-2 mb-8 border-1 border-solid border-neutral-600 rounded-lg" href="/">Back</a>
    <h1 class="text-4xl font-bold mb-2 text-neutral-100">Public exposures</h1>
    <p class="text-darkslate-200 mb-6 max-w-2xl">
      Aggregate, monthly counts of publicly exposed services hosted in Romania. This section
      deliberately never publishes an individual IP address, hostname, or organisation name — see
      <a class="underline hover:text-neutral-100" href="/methodology">methodology</a> for the redaction policy.
    </p>
    <SectionNav active="exposures" />
    {exposures.length === 0 ? (
      <p class="text-darkslate-300">This data source is not yet enabled. Check back soon.</p>
    ) : (
      <ul class="w-full">
        {exposures.map((exposure) => (
          <li class="list-none w-full mb-3 bg-darkslate-500 border border-darkslate-400 rounded-lg p-4">
            <div class="flex flex-wrap justify-between gap-2">
              <span class="font-semibold text-neutral-100">{exposure.exposureType}</span>
              <span class="text-sm text-darkslate-300">{exposure.observedMonth}</span>
            </div>
            <div class="text-sm text-darkslate-200 mt-1">
              {exposure.severity && <span class="mr-3">Severity: {exposure.severity}</span>}
              {exposure.sector && <span>Sector: {exposure.sector}</span>}
            </div>
          </li>
        ))}
      </ul>
    )}
  </main>
</Layout>
