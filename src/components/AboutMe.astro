---
import Card from "./Card/index.astro";
import { SITE } from "../site-config";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-6" title="About me">
  <div class="flex flex-col gap-2">
    <p class="sr-only">
      Hi, I'm {SITE.author.firstName}, a Cyber Security Specialist from {SITE.location.countryName}. 
      I hold a degree from DMU (De Montfort University) and specialize in Ethical Hacking, Digital Forensics, and Cryptography. 
      My mission is to help organizations and individuals stay secure in an ever-changing digital world.
    </p>
    <div aria-hidden="true" class="text-sm font-light">
      <p class="text-sm font-light">
        Hi, I'm {SITE.author.firstName}, a Cyber Security Specialist from {SITE.location.countryName}.
      </p>
      <br />
      My primary areas of expertise:
      <ul class="list-disc list-inside">
        <li>Ethical Hacking</li>
        <li>Digital Forensics</li>
        <li>Cryptography</li>
        <li>Penetration Testing</li>
        <li>Security Assessments</li>
        <li>Vulnerability Research</li>
      </ul>
      <p class="text-sm font-light mt-2">
        I hold a degree from DMU (De Montfort University).
      </p>
    </div>
    <p class="text-sm font-light">
      My mission is to help organizations and individuals stay secure in an ever-changing digital world by combining academic expertise with practical skills.
    </p>
  </div>
</Card>
