---
import { formatDate } from "../../lib/helpers";
import type { Language } from "../../lib/i18n";

interface Props {
  title: string;
  date: Date;
  id: string;
  lang?: Language;
}

const { title, date, id, lang = 'en' } = Astro.props;
const href = lang === 'en' ? `/blog/${id}` : `/ro/blog/${id}`;
---

<li class="list-none w-full mb-3">
  <a
    class="block w-full bg-darkslate-500 hover:bg-darkslate-600 border border-darkslate-400 hover:border-darkslate-300 rounded-lg p-4 md:p-5 transition-all duration-200 ease-in-out"
    href={href}
  >
    <div class="flex flex-col md:flex-row justify-between md:items-center gap-3">
      <h2 class="text-lg md:text-xl font-semibold text-neutral-100 hover:text-neutral-50 transition-colors flex-1 pr-4">
        {title}
      </h2>
      <time
        class="text-sm text-darkslate-300 whitespace-nowrap flex-shrink-0"
        data-date={date.toISOString()}
        datetime={date.toISOString()}
      >
        {formatDate(date)}
      </time>
    </div>
  </a>
</li>
