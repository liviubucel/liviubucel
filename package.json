{
  "name": "liviubucel-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual cybersecurity portfolio for Liviu Bucel",
  "author": "Liviu Bucel",
  "homepage": "https://www.liviubucel.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/liviubucel/liviubucel.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run i18n:audit && npm run security:scan && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "site-setup": "node scripts/setup.mjs",
    "eslint": "eslint 'src/**/*.{js,ts,tsx,astro}'",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "security:lockfiles": "node scripts/check-lockfiles.mjs",
    "security:audit": "pnpm audit --audit-level moderate",
    "security:audit:studio": "pnpm --dir studio-liviubucel audit --ignore-workspace --audit-level moderate",
    "security:audit:all": "pnpm security:lockfiles && pnpm security:audit && pnpm security:audit:studio",
    "sitemap:generate": "SITE_URL=https://www.liviubucel.com/ node scripts/generate-sitemap.mjs",
    "blog:normalize": "node scripts/normalize-blog-metadata.mjs",
    "blog:translate": "node scripts/translate-blog-posts.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/react": "^6.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/solid-js": "^7.0.2",
    "@astrojs/svelte": "^9.0.1",
    "@iconify-json/ri": "^1.2.10",
    "@rive-app/canvas": "^2.42.0",
    "@sanity/astro": "^3.5.1",
    "@sanity/client": "^8.5.0",
    "@sentry/astro": "^10.73.0",
    "@sentry/cloudflare": "^10.73.0",
    "@types/sanitize-html": "^2.16.1",
    "astro": "^7.3.1",
    "astro-icon": "^1.2.0",
    "astro-portabletext": "^1.0.0",
    "astro-robots-txt": "^1.0.0",
    "d3": "^7.9.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "mdast-util-to-string": "^4.0.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "reading-time": "^1.5.0",
    "sanitize-html": "^2.17.7",
    "sanity": "^6.6.0",
    "solid-js": "^1.9.15",
    "styled-components": "^6.5.3",
    "svelte": "^5.57.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.94",
    "@types/d3": "^7.4.3",
    "@types/markdown-it": "^14.1.2",
    "@typescript-eslint/parser": "^8.58.0",
    "@unocss/astro": "^66.6.7",
    "@unocss/postcss": "^66.10.0",
    "@unocss/preset-uno": "^66.10.0",
    "@unocss/reset": "^66.10.0",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "markdown-it": "^15.0.1",
    "motion": "^13.2.0",
    "typescript": "^7.0.2",
    "unocss": "^66.6.7",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "lint-staged": {
    "src/**/*.{js,ts,tsx,astro}": [
      "eslint --fix"
    ]
  },
  "packageManager": "pnpm@10.34.0",
  "optionalDependencies": {
    "lightningcss-linux-x64-gnu": "1.33.0"
  },
  "pnpm": {
    "overrides": {
      "adm-zip@<0.6.0": "0.6.0",
      "sharp@<0.35.0": "0.35.0",
      "undici@>=6.0.0 <6.28.0": "6.28.0",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "undici@>=8.0.0 <8.9.0": "8.9.0",
      "smol-toml@<1.6.1": "1.6.1",
      "uuid@<11.1.1": "11.1.1",
      "postcss@<=8.5.22": "8.5.23",
      "dompurify@<=3.4.12": "3.4.13",
      "fast-uri@<2.4.4": "2.4.4",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "fast-uri@>=4.0.0 <4.1.2": "4.1.2",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.1.4": "2.1.4",
      "brace-expansion@>=3.0.0 <3.0.6": "3.0.6",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@<3.3.18": "3.3.18",
      "nanoid@>=4.0.0 <5.1.6": "5.1.6",
      "tar@<=7.5.20": "7.5.21"
    }
  }
}
