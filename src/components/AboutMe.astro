---
import Card from "./Card/index.astro";
import { SITE } from "../site-config";

interface Props {
  lang?: "en" | "ro";
}

const { lang = "en" } = Astro.props;
const isRO = lang === "ro";
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-6" title={isRO ? "Despre mine" : "About me"}>
  <div class="flex flex-col gap-2">
    <p class="sr-only">
      {isRO ? "Sunt " : "I'm "}{SITE.author.firstName}{isRO
        ? ", locuiesc în Regatul Unit și mă concentrez pe securitate cibernetică. Lucrez la proiecte practice de ethical hacking, investigații digitale, răspuns la incidente și testare de securitate."
        : ", based in the United Kingdom and focused on cybersecurity. I work on practical projects in ethical hacking, digital investigation, incident response, and security testing."}
    </p>
    <div aria-hidden="true" class="text-sm font-light">
      <p class="text-sm font-light">
        {isRO ? "Sunt " : "I'm "}{SITE.author.firstName}{isRO
          ? ", locuiesc în Regatul Unit și mă concentrez pe securitate cibernetică."
          : ", based in the United Kingdom and focused on cybersecurity."}
      </p>
      <br />
      {isRO ? "Domenii principale:" : "Core focus areas:"}
      <ul class="list-disc list-inside">
        <li>{isRO ? "Ethical hacking" : "Ethical Hacking"}</li>
        <li>{isRO ? "Investigații digitale" : "Digital Investigation"}</li>
        <li>{isRO ? "Răspuns la incidente" : "Incident Response"}</li>
        <li>{isRO ? "Testare de securitate" : "Security Testing"}</li>
      </ul>
      <p class="text-sm font-light mt-2">
        {isRO
          ? "Construiesc experiență practică prin proiecte, laboratoare controlate și cercetare tehnică."
          : "Building hands-on experience through projects, controlled labs, and technical research."}
      </p>
    </div>
  </div>
</Card>
